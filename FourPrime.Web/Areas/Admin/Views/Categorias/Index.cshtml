@model IEnumerable<FourPrime.Domain.Entities.Categoria>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/Logo1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <title>FourPrime Garage - Gerenciar Categorias</title>

    <style>
        /* ======= TEMA PRINCIPAL ======= */
        body {
            background: #0f0f0f;
            color: #eaeaea;
        }

        .sidebar {
            position: relative;
            box-shadow: 0 0 25px rgba(153,1,0,0.25);
            border-right: 1px solid rgba(153,1,0,0.25);
        }

            .sidebar:before {
                content: "";
                position: absolute;
                right: -2px;
                top: 0;
                width: 2px;
                height: 100%;
                background: linear-gradient(180deg,#990100,#7a0000);
                box-shadow: 0 0 15px #990100,0 0 30px #990100,0 0 45px #990100;
            }

            .sidebar .nav-link {
                color: #cfcfcf;
                padding: 12px 20px;
                margin: 4px 0;
                border-radius: 8px;
                transition: .2s;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: rgba(153,1,0,.18);
                    color: #ff2a2a;
                    font-weight: 500;
                }

                .sidebar .nav-link i {
                    margin-right: 10px;
                }

            .sidebar h4 {
                color: #ffe5e5 !important;
                text-shadow: 0 0 8px #990100,0 0 15px #990100;
                font-weight: 700;
                letter-spacing: 1px;
            }

        .main-content {
            background-color: #0c0c0c;
        }

        .stat-card {
            border: none;
            border-radius: 15px;
            background: #151515;
            box-shadow: 0 0 20px rgba(153,1,0,0.05);
            transition: transform .3s ease;
            color: #eaeaea;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 0 25px rgba(153,1,0,.15);
            }

            .stat-card.primary {
                background: linear-gradient(135deg,#990100,#7a0000);
                color: #fff;
            }

            .stat-card.success {
                background: linear-gradient(135deg,#b30000,#800000);
                color: #fff;
            }

            .stat-card.warning {
                background: linear-gradient(135deg,#cc1a1a,#7a0000);
                color: #fff;
            }

            .stat-card.info {
                background: linear-gradient(135deg,#e60000,#990100);
                color: #fff;
            }

        .table-container {
            background: #151515;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(153,1,0,.06);
        }

        .table thead {
            background: #1a1a1a;
            color: #ff1a1a;
        }

        .table tbody tr:hover {
            background: rgba(153,1,0,.05);
        }

        .btn-neon-green {
            background: linear-gradient(135deg,#990100,#7a0000);
            color: #fff !important;
            border: none;
            font-weight: 600;
            box-shadow: 0 0 15px #990100;
            border-radius: 10px;
            padding: 10px 20px;
        }

            .btn-neon-green:hover {
                filter: brightness(1.2);
                box-shadow: 0 0 20px #990100;
                color: #fff !important;
            }

        .btn-outline-neon {
            border: 2px solid #990100;
            color: #ff2a2a !important;
            font-weight: 600;
            border-radius: 10px;
            padding: 10px 20px;
        }

            .btn-outline-neon:hover {
                background: #990100;
                color: #000 !important;
                box-shadow: 0 0 15px #990100;
            }

        .search-box {
            background: #1a1a1a;
            border: 1px solid rgba(153,1,0,.3);
            border-radius: 10px;
            color: #eaeaea;
            padding: 10px 15px;
        }

            .search-box:focus {
                background: #1a1a1a;
                border-color: #990100;
                box-shadow: 0 0 10px rgba(153,1,0,.3);
                color: #eaeaea;
            }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 sidebar p-0">
                <div class="p-4">
                    <h4 class="text-center mb-4"><i class="bi bi-speedometer2"></i> FourPrime Admin</h4>
                    <nav class="nav flex-column">
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house"></i> Dashboard</a>
                        <a class="nav-link" asp-controller="Carros" asp-action="Index"><i class="bi bi-car-front"></i> Gerenciar Carros</a>
                        <a class="nav-link" asp-controller="Marcas" asp-action="Index"><i class="bi bi-tags"></i> Gerenciar Marcas</a>
                        <a class="nav-link active" asp-controller="Categorias" asp-action="Index"><i class="bi bi-grid"></i> Gerenciar Categorias</a>
                        <a class="nav-link" href="#">
                            <i class="bi bi-image"></i>
                            Banner & Imagens
                        </a>
                        <a class="nav-link" href="#">
                            <i class="bi bi-gear"></i>
                            Configurações
                        </a>
                        <a class="nav-link" asp-area="Admin" asp-controller="Relatorios" asp-action="Index">
                            <i class="bi bi-bar-chart"></i>
                            Relatórios
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 main-content p-0">
                <nav class="navbar navbar-light bg-black border-bottom p-3">
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0 h1 text-light"><i class="bi bi-speedometer2 me-2"></i>Painel de Administração</span>
                        <div class="d-flex align-items-center">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2"><i class="bi bi-arrow-left"></i> Voltar ao Site</a>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-2"></i> Admin User
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Meu Perfil</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Configurações</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>

                <div class="container-fluid p-4">
                    <!-- Alertas -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Erro!</strong> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Pesquisa e Nova Categoria -->
                    <div class="filters-section mb-4">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <input type="text" class="form-control search-box" id="searchInput" placeholder="Pesquisar categorias...">
                            </div>
                            <div class="col-md-6 text-end">
                                <a asp-action="Create" class="btn-neon-green"><i class="bi bi-plus-circle me-2"></i> Nova Categoria</a>
                            </div>
                        </div>
                    </div>

                    <!-- Lista de Categorias -->
                    <div class="table-container">
                        <div class="card border-0">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Lista de Categorias</h5>
                                <span class="badge bg-primary">@Model.Count() categorias</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Nome</th>
                                                <th>Descrição</th>
                                                <th>Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody id="categoriaTableBody">
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td><strong>@item.Nome</strong></td>
                                                    <td>@item.Descricao</td>
                                                    <td>
                                                        <div class="btn-group">
                                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>

                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Busca em tempo real
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#categoriaTableBody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(searchTerm)) { row.style.display = ''; visibleCount++; }
                else { row.style.display = 'none'; }
            });

            document.querySelector('.badge.bg-primary').textContent = visibleCount + ' categorias';
        });
    </script>
</body>
</html>
