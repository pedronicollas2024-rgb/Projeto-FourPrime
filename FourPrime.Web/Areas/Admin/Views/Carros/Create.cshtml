@model FourPrime.Web.Areas.Admin.Models.CarroEditVm
@{
    ViewData["Title"] = "Novo Carro";
    Layout = null;
}

<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background: #0a0a0a;
            color: #fff;
            font-family: Segoe UI, Roboto, Arial;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            gap: 12px;
            flex-wrap: wrap;
        }

        .card-neon {
            background: #0f0f0f;
            border: 1px solid #660000;
            box-shadow: 0 0 15px rgba(255,255,255,.05);
            border-radius: 14px;
        }

        .neon-btn {
            background: linear-gradient(135deg,#990100,#660000);
            color: #fff !important;
            border: 1px solid #fff;
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: 700;
            text-decoration: none;
            transition: all .25s ease;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

            .neon-btn:hover {
                background: linear-gradient(135deg,#b30000,#800000);
                box-shadow: 0 0 18px rgba(255,255,255,.25);
                transform: translateY(-2px);
            }

        .form-control, select, textarea, input[type="text"], input[type="number"], .form-select {
            background: #111 !important;
            color: #fff !important;
            border: 1px solid #fff !important;
            padding: 10px;
            border-radius: 8px;
        }

            input::placeholder, textarea::placeholder {
                color: #cfcfcf !important;
            }

        label, .form-label, .control-label {
            color: #fff !important;
            font-weight: 600;
        }

        input[type="file"] {
            padding: 7px !important;
            cursor: pointer;
            border: 1px solid #fff !important;
            background: #111 !important;
            color: #fff !important;
        }

        .form-control:focus, select:focus, textarea:focus, .form-select:focus {
            border-color: #fff !important;
            box-shadow: 0 0 0 .2rem rgba(255,255,255,.18) !important;
        }

        .btn-secondary {
            background: #333;
            color: #fff !important;
            border: 1px solid #666;
        }

            .btn-secondary:hover {
                background: #444;
                border-color: #666;
            }

        .text-danger, .field-validation-error {
            color: #ff6b6b !important;
        }

        hr {
            border-color: #666 !important;
        }

        .image-preview img {
            border: 1px solid #fff;
            border-radius: 10px;
            box-shadow: 0 0 12px rgba(255,255,255,.08);
            max-height: 180px;
        }
    </style>
</head>

<body>

    <div class="header">
        <div>
            <h2 class="mb-0 text-white">Novo Carro</h2>
            <small class="text-white-50">Adicione um veículo ao inventário</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/" class="neon-btn">
                <i class="bi bi-arrow-left-circle"></i> Voltar ao site
            </a>
            <a asp-action="Index" class="btn btn-outline-light border-secondary text-white">
                Gerenciador
            </a>
        </div>
    </div>

    <div class="card card-neon p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Campos (inclui IsDestaque) -->
            <partial name="_Form" model="Model" />

            <!-- ✅ Tipo do Destaque (independente do IsDestaque) -->
            <div class="mb-3">
                <label class="form-label" for="DestaqueTipoSelect">Tipo do Destaque</label>
                <select asp-for="DestaqueTipo" class="form-select" id="DestaqueTipoSelect">
                    <option value="">(Sem tipo)</option>
                    <option value="Blindados">Blindados</option>
                    <option value="Esportivos">Esportivos</option>
                    <option value="Luxos">Luxos</option>
                </select>
                <small class="text-muted">
                    Pode selecionar o tipo com ou sem marcar “Mostrar em Destaque”.
                    (Ex.: só Blindados / só Destaque / ambos)
                </small>
                <span asp-validation-for="DestaqueTipo" class="text-danger"></span>
            </div>

            <hr />

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="neon-btn">
                    <i class="bi bi-save"></i> Salvar
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>
        </form>
    </div>

    <script>
        // ✅ Segurança extra: se o usuário escolher "(Sem tipo)", garante que vai vazio mesmo
        document.addEventListener('DOMContentLoaded', function () {
            const sel = document.getElementById('DestaqueTipoSelect');
            if (!sel) return;

            sel.addEventListener('change', function () {
                if (this.value === '(Sem tipo)') this.value = '';
            });
        });
    </script>

    <script>
        // Preview da imagem
        document.getElementById('ImagemFile')?.addEventListener('change', function () {
            const file = this.files[0];
            if (!file || !file.type.startsWith('image/')) return;

            const reader = new FileReader();
            reader.onload = ev => {
                document.querySelector('.image-preview')?.remove();
                const preview = document.createElement('div');
                preview.className = 'image-preview mt-3';
                preview.innerHTML = `
                    <label class="form-label text-white">Pré-visualização:</label><br/>
                    <img src="${ev.target.result}" alt="Preview" />
                `;
                this.after(preview);
            };
            reader.readAsDataURL(file);
        });
    </script>

</body>
</html>
