@model FourPrime.Web.Areas.Admin.Models.MarcaEditVm

<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="Nome" class="control-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="PaisOrigem" class="control-label"></label>
            <input asp-for="PaisOrigem" class="form-control" />
            <span asp-validation-for="PaisOrigem" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="AnoFundacao" class="control-label"></label>
            <input asp-for="AnoFundacao" class="form-control" type="number" />
            <span asp-validation-for="AnoFundacao" class="text-danger"></span>
        </div>
    </div>
</div>