@model FourPrime.Web.Areas.Admin.Models.CategoriaEditVm

@{
    ViewData["Title"] = "Nova Categoria";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/Logo1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <title>FourPrime Garage - @ViewData["Title"]</title>
    <style>
        /* ======= TEMA PRINCIPAL ======= */
        body {
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0f0f0f 100%);
            color: #eaeaea;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 20% 80%, rgba(153, 1, 0, 0.15) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(153, 1, 0, 0.12) 0%, transparent 50%), radial-gradient(circle at 40% 40%, rgba(153, 1, 0, 0.08) 0%, transparent 50%);
                pointer-events: none;
                z-index: -1;
            }

        /* ======= GLOW EFFECTS ======= */
        .glow-effect {
            position: relative;
        }

            .glow-effect::after {
                content: '';
                position: absolute;
                top: -2px;
                left: -2px;
                right: -2px;
                bottom: -2px;
                background: linear-gradient(45deg, #990100, #660000, #ff3333, #990100);
                border-radius: inherit;
                z-index: -1;
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .glow-effect:hover::after {
                opacity: 0.4;
            }

        /* ======= CARDS PREMIUM ======= */
        .admin-card {
            border: none;
            border-radius: 25px;
            background: rgba(21, 21, 21, 0.95);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(153, 1, 0, 0.25);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4), 0 5px 15px rgba(153, 1, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }

            .admin-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #990100, #ff3333, #ff6666, #990100);
                background-size: 300% 100%;
                animation: shimmer 2.5s infinite linear;
            }

            .admin-card:hover {
                transform: translateY(-10px) scale(1.02);
                box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 15px 30px rgba(153, 1, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.2);
            }

        .card-header-custom {
            background: linear-gradient(135deg, rgba(153, 1, 0, 0.95), rgba(102, 0, 0, 0.9));
            border-radius: 25px 25px 0 0 !important;
            padding: 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            position: relative;
            overflow: hidden;
        }

            .card-header-custom::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.15) 50%, transparent 70%);
                animation: shine 2.5s infinite linear;
            }

        /* ======= BOTÕES PREMIUM ======= */
        .btn-admin {
            border-radius: 15px;
            font-weight: 700;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
            border: none;
            padding: 14px 32px;
            font-size: 1rem;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

            .btn-admin::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
                transition: left 0.7s;
            }

            .btn-admin:hover::before {
                left: 100%;
            }

        .btn-primary {
            background: linear-gradient(135deg, #990100, #660000, #990100);
            background-size: 200% 100%;
            color: white;
            box-shadow: 0 6px 20px rgba(153, 1, 0, 0.4);
        }

            .btn-primary:hover {
                background-position: 100% 0;
                transform: translateY(-4px) scale(1.08);
                box-shadow: 0 12px 30px rgba(153, 1, 0, 0.5);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #2d2d2d, #1a1a1a);
            color: #eaeaea;
            border: 1px solid #444;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        }

            .btn-secondary:hover {
                background: linear-gradient(135deg, #3d3d3d, #2a2a2a);
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
                color: white;
            }

        /* ======= FORMULÁRIOS PREMIUM ======= */
        .form-control, .form-select {
            background: rgba(26, 26, 26, 0.9);
            border: 2px solid rgba(51, 51, 51, 0.7);
            color: #eaeaea;
            border-radius: 15px;
            padding: 16px 20px;
            font-size: 1rem;
            transition: all 0.4s ease;
            backdrop-filter: blur(10px);
        }

            .form-control:focus, .form-select:focus {
                background: rgba(31, 31, 31, 0.95);
                border-color: #990100;
                box-shadow: 0 0 0 0.3rem rgba(153, 1, 0, 0.3), 0 8px 25px rgba(153, 1, 0, 0.2);
                color: #eaeaea;
                transform: translateY(-3px);
            }

        .form-label {
            color: #cfcfcf;
            font-weight: 700;
            margin-bottom: 12px;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .input-group-text {
            background: linear-gradient(135deg, #990100, #660000);
            border: 2px solid rgba(51, 51, 51, 0.7);
            border-right: none;
            color: white;
            border-radius: 15px 0 0 15px;
            font-weight: 600;
        }

        /* ======= HEADER PREMIUM ======= */
        .page-header {
            border-bottom: 2px solid rgba(153, 1, 0, 0.4);
            padding-bottom: 2.5rem;
            margin-bottom: 3.5rem;
            position: relative;
        }

            .page-header::after {
                content: '';
                position: absolute;
                bottom: -2px;
                left: 0;
                width: 120px;
                height: 4px;
                background: linear-gradient(90deg, #990100, #ff3333, transparent);
                border-radius: 3px;
            }

        .page-title {
            color: #ffe6e6;
            text-shadow: 0 4px 15px rgba(153, 1, 0, 0.4);
            font-weight: 900;
            font-size: 3rem;
            letter-spacing: -1px;
            position: relative;
            display: inline-block;
        }

            .page-title::after {
                content: '';
                position: absolute;
                bottom: -15px;
                left: 0;
                width: 80px;
                height: 5px;
                background: linear-gradient(90deg, #990100, #ff3333);
                border-radius: 3px;
            }

        /* ======= BADGE PREMIUM ======= */
        .create-badge {
            background: linear-gradient(135deg, #990100, #660000);
            color: white;
            padding: 0.8rem 1.8rem;
            border-radius: 30px;
            font-size: 0.95rem;
            font-weight: 700;
            box-shadow: 0 6px 20px rgba(153, 1, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.15);
            position: relative;
            overflow: hidden;
        }

            .create-badge::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transform: rotate(45deg);
                animation: badgeShine 2.5s infinite;
            }

 

        .fade-in {
            animation: fadeIn 1s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .pulse-effect {
            animation: pulse 2s infinite ease-in-out;
        }

        /* ======= CONTAINER ======= */
        .container-custom {
            max-width: 1000px;
            margin: 0 auto;
            padding: 4rem 2rem;
        }

        /* ======= VALIDAÇÃO PREMIUM ======= */
        .field-validation-error {
            font-size: 0.9rem;
            margin-top: 8px;
            display: block;
            color: #ff6b6b;
            font-weight: 600;
            padding-left: 12px;
            border-left: 4px solid #ff6b6b;
        }

        .validation-summary-errors {
            background: rgba(153, 1, 0, 0.15);
            border: 1px solid rgba(153, 1, 0, 0.4);
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2.5rem;
            backdrop-filter: blur(10px);
            border-left: 6px solid #990100;
            box-shadow: 0 8px 25px rgba(153, 1, 0, 0.2);
        }

            .validation-summary-errors ul {
                margin-bottom: 0;
                padding-left: 1.5rem;
            }

        /* ======= DECORAÇÕES ======= */
        .floating-elements {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .floating-element {
            position: absolute;
            background: rgba(153, 1, 0, 0.05);
            border: 1px solid rgba(153, 1, 0, 0.15);
            border-radius: 50%;
            animation: float 25s infinite linear;
        }

       

        /* ======= ÍCONES ANIMADOS ======= */
        .icon-spin {
            animation: spin 3s infinite linear;
        }

        
    </style>
</head>
<body>
    <!-- Elementos flutuantes de fundo -->
    <div class="floating-elements">
        <div class="floating-element" style="width: 120px; height: 120px; top: 15%; left: 8%; animation-delay: 0s;"></div>
        <div class="floating-element" style="width: 180px; height: 180px; top: 65%; left: 85%; animation-delay: -7s;"></div>
        <div class="floating-element" style="width: 100px; height: 100px; top: 85%; left: 15%; animation-delay: -12s;"></div>
        <div class="floating-element" style="width: 140px; height: 140px; top: 25%; left: 75%; animation-delay: -18s;"></div>
    </div>

    <div class="container-custom fade-in">
        <!-- Cabeçalho da página -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-4">
                <div class="d-flex align-items-center flex-wrap gap-4">
                    <h1 class="page-title mb-0">
                        <i class="bi bi-plus-circle-fill me-3 pulse-effect"></i>@ViewData["Title"]
                    </h1>
                    <span class="create-badge">
                        <i class="bi bi-stars me-2"></i>Novo Registro
                    </span>
                </div>
                <a asp-action="Index" class="btn btn-secondary btn-admin glow-effect">
                    <i class="bi bi-arrow-left me-2"></i>Voltar à Lista
                </a>
            </div>
        </div>

        <!-- Card do formulário -->
        <div class="admin-card glow-effect">
            <div class="card-header-custom">
                <div class="d-flex align-items-center">
                    <i class="bi bi-tags-fill me-3 fs-3 text-white icon-spin"></i>
                    <h5 class="m-0 text-white fw-bold fs-4">
                        CRIAR NOVA CATEGORIA
                    </h5>
                </div>
            </div>
            <div class="card-body p-5">
                <form asp-action="Create" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <!-- Partial do formulário -->
                    <partial name="_Form" model="Model" />

                    <!-- Botões de ação -->
                    <div class="form-group mt-5 pt-5 border-top border-secondary">
                        <div class="d-flex gap-4 flex-wrap">
                            <button type="submit" class="btn btn-primary btn-admin glow-effect">
                                <i class="bi bi-check-circle-fill me-2"></i>Criar Categoria
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-admin glow-effect">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>