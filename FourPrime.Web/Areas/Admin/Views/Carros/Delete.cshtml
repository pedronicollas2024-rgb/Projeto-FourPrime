@model FourPrime.Domain.Entities.Carro

@{
    ViewData["Title"] = "Excluir Carro";
    Layout = null;
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: #0a0a0a;
            color: #ffffff;
            padding: 20px;
            font-family: Segoe UI, Roboto, Arial;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .card-neon {
            background: #0f0f0f;
            border: 1px solid #333;
            box-shadow: 0 0 14px rgba(255, 255, 255, 0.05);
            border-radius: 12px;
        }

        .neon-btn {
            background: linear-gradient(135deg,#990100,#660000);
            color: #ffffff;
            border: 1px solid #ffffff;
            padding: 8px 14px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .neon-btn:hover {
                background: linear-gradient(135deg,#b30000,#800000);
                box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
                transform: translateY(-2px);
            }
    </style>
</head>
<body>

    <div class="header">
        <div>
            <h2 class="mb-0 text-danger">Confirmar Exclusão</h2>
            <small class="text-white-50">ID: @Model.Id — @Model.Modelo</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/" class="neon-btn"><i class="bi bi-arrow-left-circle me-1"></i> Voltar ao site</a>
            <a asp-action="Index" class="btn btn-outline-light border-secondary text-white">Voltar ao gerenciador</a>
        </div>
    </div>

    <div class="card card-neon mb-4">
        <div class="card-body">
            <h4 class="text-danger">Tem certeza que deseja excluir este carro?</h4>
            <p class="text-white-50">Esta ação não pode ser desfeita.</p>

            <dl class="row">
                <dt class="col-sm-3 text-white">Modelo:</dt>
                <dd class="col-sm-9 text-white">@Model.Modelo</dd>
                <dt class="col-sm-3 text-white">Marca:</dt>
                <dd class="col-sm-9 text-white">@Model.Marca?.Nome</dd>
                <dt class="col-sm-3 text-white">Ano:</dt>
                <dd class="col-sm-9 text-white">@Model.Ano</dd>
                <dt class="col-sm-3 text-white">Preço:</dt>
                <dd class="col-sm-9 text-white">R$ @Model.Preco.ToString("N2")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger border-white"><i class="bi bi-trash me-1"></i> Confirmar Exclusão</button>
                    <a asp-action="Index" class="btn btn-secondary border-secondary text-white">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
<style>
    /* Texto dos detalhes */
    dt, dd, label, .form-label, .control-label {
        color: #ffffff !important;
        font-weight: 500;
    }

    /* Títulos */
    h1, h2, h3, h4, h5, h6 {
        color: #ffffff !important;
    }

    /* Container principal */
    .card, .card-body {
        background: #0f0f0f !important;
        border: 1px solid #333;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.05);
        color: #ffffff !important;
    }

        /* Texto de dentro do card */
        .card p, .card span, .card small {
            color: #ffffff !important;
        }

    /* Botões */
    .btn-danger {
        background: linear-gradient(135deg, #990100, #660000);
        border: 1px solid #ffffff;
        color: #fff !important;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #b30000, #800000);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

    .btn-secondary {
        background: #202020;
        border: 1px solid #666;
        color: #ffffff !important;
    }

    /* Botão neon vermelho */
    .btn-neon-red {
        background: linear-gradient(135deg, #990100, #660000);
        color: #fff !important;
        border: 1px solid #ffffff;
        font-weight: 600;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
    }

        .btn-neon-red:hover {
            background: linear-gradient(135deg, #b30000, #800000);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

    /* Botão neon outline */
    .btn-outline-neon {
        border: 2px solid #ffffff;
        color: #ffffff !important;
        font-weight: 600;
        background: transparent;
        transition: all 0.3s ease;
    }

        .btn-outline-neon:hover {
            background: #ffffff;
            color: #000 !important;
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
        }

    /* Efeitos de foco para inputs */
    .form-control:focus {
        border-color: #ffffff !important;
        box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25) !important;
    }

    /* Badges e elementos de status */
    .badge-danger {
        background: linear-gradient(135deg, #990100, #660000) !important;
        color: #fff !important;
        border: 1px solid #ffffff;
    }

    /* Links */
    a {
        color: #ffffff;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        a:hover {
            color: #cccccc;
        }

    /* Efeito de glow para títulos */
    .glow-text {
        color: #fff;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    }

    /* Textos secundários */
    .text-muted {
        color: #cccccc !important;
    }

    .text-white-50 {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* Validação */
    .text-danger {
        color: #ff6b6b !important;
    }

    .field-validation-error {
        color: #ff6b6b !important;
    }

    /* Input hidden - manter sem borda */
    input[type="hidden"] {
        border: none !important;
        background: transparent !important;
    }

</style>

</html>