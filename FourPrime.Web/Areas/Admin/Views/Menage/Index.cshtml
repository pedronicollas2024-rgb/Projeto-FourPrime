@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Gestão do Sistema";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    </div>

    <!-- Cards de Estatísticas -->
    <div class="row">
        <!-- Card Carros -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Carros Cadastrados
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewData["TotalCarros"]</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-car fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Marcas -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Marcas
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewData["TotalMarcas"]</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-industry fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Categorias -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Categorias
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewData["TotalCategorias"]</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tags fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Usuários -->
        @if ((await AuthorizationService.AuthorizeAsync(User, "Admin")).Succeeded)
        {
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                    Usuários
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewData["TotalUsuarios"]</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-users fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Módulos de Gestão -->
    <div class="row">
        <!-- Gestão de Carros -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-car mr-2"></i>Gestão de Carros
                    </h6>
                </div>
                <div class="card-body">
                    <p>Gerencie o catálogo completo de carros do sistema.</p>
                    <div class="btn-group-vertical w-100">
                        <a asp-controller="Carros" asp-action="Index" class="btn btn-primary btn-block mb-2">
                            <i class="fas fa-list"></i> Listar Carros
                        </a>
                        <a asp-controller="Carros" asp-action="Create" class="btn btn-outline-primary btn-block">
                            <i class="fas fa-plus"></i> Novo Carro
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gestão de Marcas -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">
                        <i class="fas fa-industry mr-2"></i>Gestão de Marcas
                    </h6>
                </div>
                <div class="card-body">
                    <p>Gerencie as marcas de veículos disponíveis no sistema.</p>
                    <div class="btn-group-vertical w-100">
                        <a asp-controller="Marcas" asp-action="Index" class="btn btn-success btn-block mb-2">
                            <i class="fas fa-list"></i> Listar Marcas
                        </a>
                        <a asp-controller="Marcas" asp-action="Create" class="btn btn-outline-success btn-block">
                            <i class="fas fa-plus"></i> Nova Marca
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Gestão de Categorias -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-warning">
                        <i class="fas fa-tags mr-2"></i>Gestão de Categorias
                    </h6>
                </div>
                <div class="card-body">
                    <p>Gerencie as categorias de veículos do sistema.</p>
                    <div class="btn-group-vertical w-100">
                        <a asp-controller="Categorias" asp-action="Index" class="btn btn-warning btn-block mb-2">
                            <i class="fas fa-list"></i> Listar Categorias
                        </a>
                        <a asp-controller="Categorias" asp-action="Create" class="btn btn-outline-warning btn-block">
                            <i class="fas fa-plus"></i> Nova Categoria
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gestão de Usuários (Apenas Admin) -->
        @if ((await AuthorizationService.AuthorizeAsync(User, "Admin")).Succeeded)
        {
            <div class="col-lg-6 mb-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-info">
                            <i class="fas fa-users mr-2"></i>Gestão de Usuários
                        </h6>
                    </div>
                    <div class="card-body">
                        <p>Gerencie os usuários e permissões do sistema.</p>
                        <div class="btn-group-vertical w-100">
                            <a asp-controller="Usuarios" asp-action="Index" class="btn btn-info btn-block mb-2">
                                <i class="fas fa-list"></i> Listar Usuários
                            </a>
                            <a asp-controller="Usuarios" asp-action="Create" class="btn btn-outline-info btn-block">
                                <i class="fas fa-plus"></i> Novo Usuário
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Acesso Rápido -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Acesso Rápido</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Carros" asp-action="Create" class="btn btn-primary btn-block">
                                <i class="fas fa-plus"></i> Novo Carro
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Marcas" asp-action="Create" class="btn btn-success btn-block">
                                <i class="fas fa-plus"></i> Nova Marca
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Categorias" asp-action="Create" class="btn btn-warning btn-block">
                                <i class="fas fa-plus"></i> Nova Categoria
                            </a>
                        </div>
                        @if ((await AuthorizationService.AuthorizeAsync(User, "Admin")).Succeeded)
                        {
                            <div class="col-md-3 mb-3">
                                <a asp-controller="Usuarios" asp-action="Create" class="btn btn-info btn-block">
                                    <i class="fas fa-plus"></i> Novo Usuário
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>