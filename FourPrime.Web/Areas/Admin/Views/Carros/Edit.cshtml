@model FourPrime.Web.Areas.Admin.Models.CarroEditVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Editar Carro";
    Layout = null;
}

<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background: #0a0a0a;
            color: #eaeaea;
            padding: 20px;
            font-family: Segoe UI, Roboto, Arial;
        }

        .card-neon {
            background: #0f0f0f;
            border: 1px solid rgba(153,1,0,.25);
            box-shadow: 0 0 15px rgba(153,1,0,.18);
            border-radius: 12px;
            color: #eaeaea !important;
        }

        .btn-neon-red {
            background: linear-gradient(135deg, #990100, #660000);
            color: #fff !important;
            font-weight: 700;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 10px;
            padding: 10px 16px;
            box-shadow: 0 0 15px rgba(153,1,0,.25);
        }

            .btn-neon-red:hover {
                filter: brightness(1.1);
                box-shadow: 0 0 22px rgba(153,1,0,.35);
            }

        .form-control, .form-select, textarea, input[type="file"] {
            background: #111 !important;
            color: #fff !important;
            border: 1px solid rgba(255,255,255,.5) !important;
            border-radius: 10px;
        }

        label, .form-label {
            color: #eaeaea !important;
            font-weight: 600;
        }

        .text-muted {
            color: rgba(255,255,255,.65) !important;
        }
    </style>
</head>

<body>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0 text-white">Editar Carro</h2>
            <small class="text-muted">@Model.Modelo</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/" class="btn btn-outline-light">
                <i class="bi bi-arrow-left-circle me-1"></i> Voltar ao site
            </a>
            <a asp-action="Index" class="btn btn-outline-light">
                Voltar ao gerenciador
            </a>
        </div>
    </div>

    <div class="card card-neon">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Modelo" class="form-label"></label>
                        <input asp-for="Modelo" class="form-control" />
                        <span asp-validation-for="Modelo" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Ano" class="form-label"></label>
                        <input asp-for="Ano" class="form-control" type="number" />
                        <span asp-validation-for="Ano" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Preco" class="form-label"></label>
                        <input asp-for="Preco" class="form-control" />
                        <span asp-validation-for="Preco" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MarcaId" class="form-label"></label>
                        <select asp-for="MarcaId"
                                class="form-select"
                                asp-items="@(new SelectList(Model.Marcas, "Id", "Nome", Model.MarcaId))">
                            <option value="">Selecione...</option>
                        </select>
                        <span asp-validation-for="MarcaId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CategoriaId" class="form-label"></label>
                        <select asp-for="CategoriaId"
                                class="form-select"
                                asp-items="@(new SelectList(Model.Categorias, "Id", "Nome", Model.CategoriaId))">
                            <option value="">Selecione...</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Quilometragem" class="form-label"></label>
                        <input asp-for="Quilometragem" class="form-control" type="number" />
                        <span asp-validation-for="Quilometragem" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Cor" class="form-label"></label>
                        <input asp-for="Cor" class="form-control" />
                        <span asp-validation-for="Cor" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Combustivel" class="form-label"></label>
                        <input asp-for="Combustivel" class="form-control" />
                        <span asp-validation-for="Combustivel" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ImagemFile" class="form-label"></label>
                        <input asp-for="ImagemFile" type="file" accept="image/*" class="form-control" id="ImagemFile" />
                        <span asp-validation-for="ImagemFile" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check mt-4">
                            <input class="form-check-input" asp-for="IsDestaque" id="IsDestaque" />
                            <label class="form-check-label" asp-for="IsDestaque">Mostrar em Destaque</label>
                        </div>
                    </div>

                    <!-- ✅ Tipo do Destaque (SEMPRE LIBERADO e NÃO APAGA sozinho) -->
                    <div class="col-12">
                        <label class="form-label" for="DestaqueTipoSelect">Tipo do Destaque</label>
                        <select asp-for="DestaqueTipo" class="form-select" id="DestaqueTipoSelect">
                            <option value="">(Sem tipo)</option>
                            <option value="Blindados">Blindados</option>
                            <option value="Esportivos">Esportivos</option>
                            <option value="Luxos">Luxos</option>
                        </select>
                        <small class="text-muted">
                            Pode selecionar o tipo com ou sem marcar “Mostrar em Destaque”.
                            (Ex.: só Blindados / só Destaque / ambos)
                        </small>
                        <span asp-validation-for="DestaqueTipo" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descricao" class="form-label"></label>
                        <textarea asp-for="Descricao" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ImagemUrl))
                {
                    <div class="mt-3">
                        <label class="form-label">Imagem atual:</label>
                        <div>
                            <img src="@Model.ImagemUrl"
                                 style="max-height:160px;border-radius:10px;border:1px solid rgba(255,255,255,.35);" />
                        </div>
                    </div>
                }

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn-neon-red">
                        <i class="bi bi-save me-2"></i>Salvar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ✅ removeu a lógica antiga que desabilitava e limpava o tipo baseado no IsDestaque
        // Segurança extra: garante que "(Sem tipo)" fique vazio mesmo
        document.addEventListener('DOMContentLoaded', function () {
            const sel = document.getElementById('DestaqueTipoSelect');
            if (!sel) return;

            sel.addEventListener('change', function () {
                if (this.value === '(Sem tipo)') this.value = '';
            });
        });
    </script>

    <script>
        // Preview da imagem
        document.getElementById('ImagemFile')?.addEventListener('change', function () {
            const file = this.files[0];
            if (!file || !file.type.startsWith('image/')) return;

            const reader = new FileReader();
            reader.onload = ev => {
                document.querySelector('.image-preview')?.remove();
                const p = document.createElement('div');
                p.className = 'image-preview mt-2';
                p.innerHTML =
                    `<label class="form-label">Pré-visualização</label>
                     <div><img src="${ev.target.result}" style="max-height:180px;border-radius:10px;border:1px solid rgba(255,255,255,.35);" /></div>`;
                document.getElementById('ImagemFile').after(p);
            };
            reader.readAsDataURL(file);
        });
    </script>
</body>
</html>
