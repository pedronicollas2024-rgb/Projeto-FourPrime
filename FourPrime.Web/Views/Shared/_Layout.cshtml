<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Mulish:ital,wght@0,200..1000;1,200..1000&display=swap%22
          rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="~/img/logo cortada.PNG">
    <title>FourPrime | Garage</title>

    <style>
        /* ======= NAVBAR PREMIUM ======= */
        .premium-navbar {
            background: black !important;
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(153, 1, 0, 0.3);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            position: relative;
            padding: 12px 0;
        }



        /* ======= LOGO ======= */
        .premium-logo {
            transition: all 0.3s ease;
            position: relative;
        }

            .premium-logo:hover {
                transform: scale(1.05);
            }

            .premium-logo::after {
                content: '';
                position: absolute;
                bottom: -5px;
                left: 0;
                width: 0;
                height: 2px;
                background: linear-gradient(90deg, #990100, #ff3333);
                transition: width 0.3s ease;
            }

            .premium-logo:hover::after {
                width: 100%;
            }

        /* ======= BOTÃO TOGGLER ======= */
        .premium-toggler {
            border: 1px solid rgba(153, 1, 0, 0.4);
            padding: 8px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .premium-toggler:hover {
                border-color: #990100;
                background: rgba(153, 1, 0, 0.1);
            }

            .premium-toggler .navbar-toggler-icon {
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.8%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
            }

        /* ======= LINKS DE NAVEGAÇÃO ======= */
        .premium-nav-link {
            color: #eaeaea !important;
            font-weight: 600;
            padding: 12px 16px !important;
            border-radius: 10px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .premium-nav-link::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(153, 1, 0, 0.2), transparent);
                transition: left 0.6s;
            }

            .premium-nav-link:hover {
                color: #fff !important;
                background: rgba(153, 1, 0, 0.1);
                transform: translateY(-2px);
            }

                .premium-nav-link:hover::before {
                    left: 100%;
                }

            .premium-nav-link i {
                color: #990100;
                transition: all 0.3s ease;
            }

            .premium-nav-link:hover i {
                color: #ff3333;
                transform: scale(1.2);
            }

        /* ======= LINK ADMIN ======= */
        .premium-admin-link {
            color: #ffd700 !important;
            font-weight: 700;
            padding: 12px 16px !important;
            border-radius: 10px;
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid rgba(255, 215, 0, 0.3);
            transition: all 0.3s ease;
        }

            .premium-admin-link:hover {
                color: #fff !important;
                background: rgba(255, 215, 0, 0.2);
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
            }

        /* ======= BOTÃO LOGIN ======= */
        .premium-login-btn {
            background: linear-gradient(135deg, #990100, #660000);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
          
        }

            .premium-login-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.6s;
            }

            .premium-login-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(153, 1, 0, 0.4);
                color: white;
            }

                .premium-login-btn:hover::before {
                    left: 100%;
                }

        /* ======= DROPDOWN DO USUÁRIO ======= */
        .premium-user-dropdown {
            color: #eaeaea !important;
            padding: 8px 16px;
            border-radius: 12px;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

            .premium-user-dropdown:hover {
                background: rgba(153, 1, 0, 0.1);
                border-color: rgba(153, 1, 0, 0.3);
            }

        .user-avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #990100, #660000);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .user-info {
            text-align: left;
        }

        .user-email {
            font-size: 0.9rem;
            font-weight: 600;
            color: #eaeaea;
        }

        .user-badge {
            font-size: 0.75rem;
            color: #ffd700;
            font-weight: 600;
        }

        .dropdown-arrow {
            font-size: 0.8rem;
            color: #990100;
            transition: transform 0.3s ease;
        }

        .premium-user-dropdown.show .dropdown-arrow {
            transform: rotate(180deg);
        }

        /* ======= DROPDOWN MENU ======= */
        .premium-dropdown-menu {
            background: rgba(21, 21, 21, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(153, 1, 0, 0.3);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            padding: 8px;
            margin-top: 10px !important;
        }

        .premium-dropdown-item {
            color: #eaeaea;
            padding: 12px 16px;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

            .premium-dropdown-item:hover {
                background: rgba(153, 1, 0, 0.2);
                color: #fff;
                transform: translateX(5px);
            }

            .premium-dropdown-item i {
                color: #990100;
                width: 20px;
                text-align: center;
            }

        .admin-item {
            color: #ffd700 !important;
            font-weight: 700;
        }

            .admin-item i {
                color: #ffd700 !important;
            }

        .logout-item {
            color: #ff6b6b !important;
        }

            .logout-item:hover {
                background: rgba(255, 107, 107, 0.2) !important;
            }

        .premium-divider {
            border-color: rgba(153, 1, 0, 0.3);
            margin: 8px 0;
        }



     
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark w-100 premium-navbar">
            <div class="w-100 px-4 d-flex justify-content-between align-items-center">

                <!-- Logo -->
                <a class="navbar-brand premium-logo" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo cortada.PNG" style="height: auto; width: 160px" alt="FourPrime">
                </a>

                <!-- Botão Mobile -->
                <button class="navbar-toggler premium-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Conteúdo do Navbar -->
                <div class="collapse navbar-collapse premium-navbar-content" id="navbarSupportedContent">

                    <!-- Menu Principal -->
                    <ul class="navbar-nav me-auto premium-nav">
                        <li class="nav-item me-4">
                            <a class="nav-link premium-nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-2"></i>Início
                            </a>
                        </li>
                        <li class="nav-item me-4">
                            <a class="nav-link premium-nav-link" asp-controller="Home" asp-action="Index" asp-fragment="cards">
                                <i class="bi bi-car-front me-2"></i>Veículos
                            </a>

                        </li>
                        <li class="nav-item me-4">
                            <a class="nav-link premium-nav-link" asp-controller="Home" asp-action="About">
                                <i class="bi bi-building me-2"></i>Sobre nós
                            </a>
                        </li>
                        <li class="nav-item me-4">
                            <a class="nav-link premium-nav-link" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-telephone me-2"></i>Contato
                            </a>
                        </li>

                        @{
                            var userRole = Context.Session.GetString("UsuarioRole");
                            var isLoggedIn = Context.Session.GetString("UsuarioLogado") == "true";
                        }

                        @if (isLoggedIn && userRole == "Admin")
                        {
                            <li class="nav-item me-4">
                                <a class="nav-link premium-admin-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-2"></i>Admin
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Menu do Usuário -->
                    <ul class="navbar-nav premium-user-nav d-flex align-items-center">

                        @{
                            var userEmail = Context.Session.GetString("UsuarioEmail");
                        }

                        @if (isLoggedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle premium-user-dropdown d-flex align-items-center" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">

                                    <!-- Avatar do Usuário -->
                                    <div class="user-avatar me-3">
                                        @if (userRole == "Admin")
                                        {
                                            <i class="bi bi-shield-check"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle"></i>
                                        }
                                    </div>

                                    <div class="user-info">
                                        <div class="user-email">@userEmail</div>
                                        @if (userRole == "Admin")
                                        {
                                            <div class="user-badge">Administrador</div>
                                        }
                                    </div>

                                    <i class="bi bi-chevron-down ms-2 dropdown-arrow"></i>
                                </a>

                                <ul class="dropdown-menu premium-dropdown-menu">
                                    @if (userRole == "Admin")
                                    {
                                        <li>
                                            <a class="dropdown-item premium-dropdown-item admin-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-3"></i>
                                                <span>Painel Admin</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider premium-divider"></li>
                                        <li>
                                            <a class="dropdown-item premium-dropdown-item" asp-area="Admin" asp-controller="Carros" asp-action="Index">
                                                <i class="bi bi-car-front me-3"></i>
                                                <span>Gerenciar Carros</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item premium-dropdown-item" asp-area="Admin" asp-controller="Marcas" asp-action="Index">
                                                <i class="bi bi-tags me-3"></i>
                                                <span>Gerenciar Marcas</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item premium-dropdown-item" asp-area="Admin" asp-controller="Categorias" asp-action="Index">
                                                <i class="bi bi-grid me-3"></i>
                                                <span>Gerenciar Categorias</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider premium-divider"></li>
                                    }

                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline w-100">
                                            <button type="submit" class="dropdown-item premium-dropdown-item logout-item w-100">
                                                <i class="bi bi-box-arrow-right me-3"></i>
                                                <span>Sair</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn premium-login-btn d-flex align-items-center text-light" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-person-fill me-2"></i>
                                    <span>Conecte-se</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- REMOVI O CONTAINER AQUI -->
    <main role="main" class="">

        @RenderBody()
    </main>

    <footer class="footer text-light w-100 mt-4 py-3 bg-black text-center">
        <a href="#">
            <img src="/img/logo cortada.PNG" style="height: auto; width: 150px" alt="FourPrime Logo" />
        </a>
        <p class="mt-3 mb-0">Desenvolvido por Pixel Flux&copy; 2025. Todos os direitos reservados.</p>
        <div class="px-0">
            &copy; 2025 - FourPrime -
            <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Adiciona classe active ao link atual
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.premium-nav-link');

            navLinks.forEach(link => {
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                    link.style.background = 'rgba(153, 1, 0, 0.2)';
                    link.style.color = '#ff3333 !important';
                }
            });

            // Smooth scroll para âncoras
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
    
</body>
</html>

