@model FourPrime.Web.Models.RegisterVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
}

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        background: linear-gradient(rgba(10, 10, 10, 0.85), rgba(10, 10, 10, 0.9)), url('~/wwwroot/img/FundoSite.png');
        overflow: hidden;
    }

    .login-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 10, 10, 0.7);
        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .login-card {
        background: rgba(21, 21, 21, 0.65);
        backdrop-filter: blur(20px);
        padding: 35px 30px;
        width: 380px;
        border-radius: 20px;
        border: 1px solid rgba(153, 1, 0, 0.4);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        text-align: center;
        color: #fff;
        position: relative;
    }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #990100, #ff3333, #990100);
            animation: shimmer 3s infinite linear;
        }

    .login-header {
        margin-bottom: 25px;
    }

    .login-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: linear-gradient(135deg, #990100, #660000);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-header h2 {
        font-weight: 700;
        color: #ffe6e6;
        font-size: 1.6rem;
    }

    .login-header p {
        font-size: 0.9rem;
        color: #cfcfcf;
    }

    .input-group-custom {
        margin-bottom: 18px;
        text-align: left;
    }

        .input-group-custom label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #cfcfcf;
            margin-bottom: 6px;
            display: block;
            text-transform: uppercase;
        }

    .input-dark {
        width: 100%;
        background: rgba(26, 26, 26, 0.7);
        border: 1.5px solid rgba(51, 51, 51, 0.6);
        color: #eaeaea;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .btn-primary-neural {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        background: linear-gradient(135deg, #990100, #660000);
        margin-top: 10px;
    }

    .footer-register {
        font-size: 0.85rem;
        color: #cfcfcf;
        margin-top: 20px;
    }

        .footer-register a {
            color: #990100;
            font-weight: 600;
            text-decoration: none;
        }

    .alert-danger {
        background: rgba(153, 1, 0, 0.15);
        border: 1px solid rgba(153, 1, 0, 0.4);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
        font-size: 0.85rem;
    }

    .text-danger {
        color: #ff6b6b !important;
        font-size: 0.8rem;
    }
</style>

<div class="login-overlay">
    <div class="login-card">

        <div class="login-header">
            <div class="login-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <h2>FourPrime</h2>
            <p>Criar Conta</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-danger">
                @Html.ValidationSummary(true)
            </div>
        }

        <form asp-controller="Auth"
              asp-action="Register"
              method="post">

            <div class="input-group-custom">
                <label asp-for="NomeCompleto"></label>
                <input asp-for="NomeCompleto" class="input-dark" />
                <span asp-validation-for="NomeCompleto" class="text-danger"></span>
            </div>

            <div class="input-group-custom">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="input-dark" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="input-group-custom">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="input-dark" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="input-group-custom">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" type="password" class="input-dark" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary-neural">
                Criar Conta
            </button>

        </form>

        <div class="footer-register">
            Já tem conta?
            <a asp-controller="Auth"
               asp-action="Login">
                Entrar
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
