@model FourPrime.Web.Models.LoginVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
}

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        background: linear-gradient(rgba(10, 10, 10, 0.85), rgba(10, 10, 10, 0.9)), url('~/wwwroot/img/FundoSite.png');
        overflow: hidden;
    }

    .login-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 10, 10, 0.7);
        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .login-card {
        background: rgba(21, 21, 21, 0.65);
        backdrop-filter: blur(20px);
        padding: 35px 30px;
        width: 360px;
        border-radius: 20px;
        border: 1px solid rgba(153, 1, 0, 0.4);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        text-align: center;
        color: #fff;
        position: relative;
    }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #990100, #ff3333, #990100);
            animation: shimmer 3s infinite linear;
        }

    .login-header {
        margin-bottom: 25px;
    }

    .login-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: linear-gradient(135deg, #990100, #660000);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-header h2 {
        font-weight: 700;
        color: #ffe6e6;
        font-size: 1.6rem;
    }

    .login-header p {
        font-size: 0.9rem;
        color: #cfcfcf;
    }

    .input-group-custom {
        margin-bottom: 20px;
        text-align: left;
    }

        .input-group-custom label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #cfcfcf;
            margin-bottom: 6px;
            display: block;
            text-transform: uppercase;
        }

    .input-dark {
        width: 100%;
        background: rgba(26, 26, 26, 0.7);
        border: 1.5px solid rgba(51, 51, 51, 0.6);
        color: #eaeaea;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .remember-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        margin-bottom: 25px;
        color: #cfcfcf;
    }

    .btn-primary-neural {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        background: linear-gradient(135deg, #990100, #660000);
    }

    .divider {
        margin: 25px 0 20px;
        color: #666;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .social-buttons {
        display: flex;
        gap: 12px;
        margin-bottom: 25px;
    }

    .social-btn {
        flex: 1;
        padding: 12px;
        border-radius: 10px;
        border: 1.5px solid rgba(51, 51, 51, 0.6);
        background: rgba(26, 26, 26, 0.6);
        color: #eaeaea;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .footer-register {
        font-size: 0.85rem;
        color: #cfcfcf;
    }

        .footer-register a {
            color: #990100;
            font-weight: 600;
            text-decoration: none;
        }

    .alert-danger {
        background: rgba(153, 1, 0, 0.15);
        border: 1px solid rgba(153, 1, 0, 0.4);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
        font-size: 0.85rem;
    }

    .alert-success {
        background: rgba(0, 200, 0, 0.15);
        border: 1px solid rgba(0, 200, 0, 0.4);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
        font-size: 0.85rem;
    }

    .text-danger {
        color: #ff6b6b !important;
        font-size: 0.8rem;
    }
</style>

<div class="login-overlay">
    <div class="login-card">

        <div class="login-header">
            <div class="login-icon">
                <i class="bi bi-car-front-fill"></i>
            </div>

            <h2>FourPrime</h2>
            <p>Acesso ao Sistema</p>
        </div>

        @* Mensagem de sucesso após cadastro *@
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert-success">
                @TempData["Sucesso"]
            </div>
        }

        @* Erros *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-danger">
                @Html.ValidationSummary(true)
            </div>
        }

        <form asp-controller="Auth"
              asp-action="Login"
              method="post">

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewData["ReturnUrl"]" />

            <div class="input-group-custom">
                <label asp-for="Email"></label>

                <input asp-for="Email"
                       class="input-dark"
                       placeholder="seu@email.com" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="input-group-custom">
                <label asp-for="Password"></label>

                <input asp-for="Password"
                       class="input-dark"
                       type="password"
                       placeholder="••••••••" />

                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="remember-row">
                <div>
                    <input asp-for="RememberMe" />
                    <label asp-for="RememberMe"></label>
                </div>
            </div>

            <button type="submit"
                    class="btn-primary-neural">
                Entrar
            </button>

        </form>

        <div class="divider">Ou</div>

        <div class="social-buttons">
            <a class="social-btn google"
               asp-controller="Auth"
               asp-action="GoogleLogin">
                Google
            </a>


            <button class="social-btn github">
                GitHub
            </button>
        </div>

        <div class="footer-register">
            Novo?
            <a asp-controller="Auth"
               asp-action="Register">
                Criar conta
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
