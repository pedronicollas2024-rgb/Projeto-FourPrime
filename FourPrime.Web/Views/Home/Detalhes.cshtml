@using FourPrime.Application.DTOs
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model FourPrime.Web.Models.CarroDetalhesDto

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <title>FourPrime | Garage - @Model.Modelo</title>
    <style>
        /* ======= BASE E RESET ======= */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0f0f0f 100%) !important;
            min-height: 100vh;
            font-family: 'Mulish', sans-serif;
            position: relative;
            color: #eaeaea;
        }

            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 20% 80%, rgba(153, 1, 0, 0.15) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(153, 1, 0, 0.12) 0%, transparent 50%);
                pointer-events: none;
                z-index: -1;
            }

        /* ======= CARROSSEL PREMIUM ======= */
        .premium-carousel {
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid rgba(153, 1, 0, 0.3);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            position: relative;
        }

            .premium-carousel::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #990100, #ff3333, #990100);
                z-index: 3;
            }

        .carousel-inner {
            border-radius: 20px;
        }

        .carousel-item img {
            height: 500px;
            object-fit: cover;
            width: 100%;
        }

        .carousel-control-prev,
        .carousel-control-next {
            width: 60px;
            height: 60px;
            background: rgba(153, 1, 0, 0.8);
            border-radius: 50%;
            top: 50%;
            transform: translateY(-50%);
            margin: 0 20px;
            opacity: 0.8;
            transition: all 0.3s ease;
        }

            .carousel-control-prev:hover,
            .carousel-control-next:hover {
                opacity: 1;
                transform: translateY(-50%) scale(1.1);
                background: #990100;
            }

        /* ======= CARDS PREMIUM ======= */
        .premium-card {
            background: rgba(21, 21, 21, 0.8);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(153, 1, 0, 0.3);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4), 0 5px 15px rgba(153, 1, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.4s ease;
            overflow: hidden;
            position: relative;
        }

            .premium-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #990100, #ff3333, #990100);
                z-index: 2;
            }

        /* ======= INFORMAÇÕES DO VEÍCULO ======= */
        .vehicle-header {
            margin-bottom: 30px;
        }

        .vehicle-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 3rem;
            color: #ffe6e6;
            text-shadow: 0 4px 15px rgba(153, 1, 0, 0.3);
            margin-bottom: 20px;
            letter-spacing: 1px;
        }

        .price-tag {
            background: linear-gradient(135deg, #990100, #660000);
            color: white;
            padding: 20px 30px;
            border-radius: 15px;
            font-size: 2.2rem;
            font-weight: 800;
            display: inline-block;
            box-shadow: 0 10px 25px rgba(153, 1, 0, 0.3);
            border: 2px solid rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

            .price-tag::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
                transform: rotate(45deg);
                animation: shine 3s infinite;
            }

        /* ======= BOTÃO FAVORITO ======= */
        .favorite-btn {
            background: rgba(26, 26, 26, 0.8);
            border: 1px solid rgba(153, 1, 0, 0.4);
            color: #cfcfcf;
            padding: 12px 25px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            backdrop-filter: blur(10px);
        }

            .favorite-btn:hover {
                background: linear-gradient(135deg, #990100, #660000);
                color: white;
                border-color: transparent;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(153, 1, 0, 0.3);
            }

        /* ======= ESPECIFICAÇÕES ======= */
        .specs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .spec-item {
            background: rgba(26, 26, 26, 0.6);
            padding: 15px;
            border-radius: 12px;
            border-left: 4px solid #990100;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

            .spec-item:hover {
                background: rgba(153, 1, 0, 0.1);
                transform: translateX(5px);
            }

        .spec-label {
            color: #cfcfcf;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }

        .spec-value {
            color: #ffe6e6;
            font-weight: 700;
            font-size: 1.1rem;
        }

        /* ======= COMPARAÇÃO DE PREÇOS ======= */
        .comparison-card {
            background: rgba(21, 21, 21, 0.9);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(153, 1, 0, 0.3);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        }

        .comparison-title {
            color: #ffe6e6;
            font-weight: 700;
            margin-bottom: 25px;
            font-size: 1.4rem;
            text-align: center;
        }

        .price-comparison {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            text-align: center;
        }

        .price-column {
            padding: 25px;
            border-radius: 15px;
            background: rgba(26, 26, 26, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

            .price-column:hover {
                background: rgba(153, 1, 0, 0.1);
                border-color: rgba(153, 1, 0, 0.4);
                transform: translateY(-5px);
            }

        .price-amount {
            font-size: 2rem;
            font-weight: 800;
            color: #ffe6e6;
            margin-bottom: 10px;
        }

        .price-source {
            color: #990100;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .price-description {
            color: #cfcfcf;
            font-size: 0.9rem;
            line-height: 1.4;
        }

        /* ======= BADGES ======= */
        .vehicle-badge {
            background: linear-gradient(135deg, #990100, #660000);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 12px rgba(153, 1, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

  
        .fade-in-up {
            animation: fadeInUp 0.8s ease-out;
        }

        /* ======= SEÇÕES ======= */
        .section-spacing {
            padding: 60px 0;
        }

        /* ======= BOTÕES DE AÇÃO ======= */
        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        .btn-premium {
            background: linear-gradient(135deg, #990100, #660000);
            border: none;
            color: white;
            padding: 15px 30px;
            border-radius: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-premium:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(153, 1, 0, 0.4);
                color: white;
            }

        .btn-outline-premium {
            background: transparent;
            border: 2px solid #990100;
            color: #990100;
            padding: 15px 30px;
            border-radius: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-outline-premium:hover {
                background: #990100;
                color: white;
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(153, 1, 0, 0.3);
            }

        .text-glow {
            color: #ffe6e6;
            text-shadow: 0 0 10px rgba(153, 1, 0, 0.3);
        }

        /* ======= IMAGEM DINÂMICA ======= */
        .premium-image {
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid rgba(153, 1, 0, 0.3);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            position: relative;
        }

            .premium-image::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #990100, #ff3333, #990100);
                z-index: 3;
            }

            .premium-image img {
                height: 500px;
                object-fit: cover;
                width: 100%;
            }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- Conteúdo principal -->
    <main class="flex-grow-1">
        <section class="section-spacing">
            <div class="container">
                <div class="row align-items-start">

                    <!-- IMAGEM DINÂMICA -->
                    <div class="col-lg-7 mb-4 fade-in-up">
                        <div class="premium-image">
                            @if (!string.IsNullOrEmpty(Model.ImagemUrl))
                            {
                                <img src="@Model.ImagemUrl" class="d-block w-100" alt="@Model.Modelo" />
                            }
                            else
                            {
                                <img src="~/img/placeholder-car.png" class="d-block w-100" alt="Sem imagem" />
                            }
                        </div>
                    </div>

                    <!-- INFORMAÇÕES DO CARRO -->
                    <div class="col-lg-5 fade-in-up" style="animation-delay: 0.2s;">
                        <div class="vehicle-header">
                            <h1 class="vehicle-title">@Model.Modelo.ToUpper()</h1>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="vehicle-badge">@Model.Categoria?.ToUpper()</span>
                                <span class="vehicle-badge">LUXO</span>
                                <span class="vehicle-badge">EXCLUSIVO</span>
                            </div>
                            <div class="price-tag mb-4">
                                R$ @Model.Preco.ToString("N0")
                            </div>
                            <a href="#" class="favorite-btn">
                                <i class="bi bi-heart"></i> Adicionar aos Favoritos
                            </a>
                        </div>

                        <div class="premium-card p-4">
                            <h4 class="text-glow mb-4">Especificações Técnicas</h4>
                            <div class="specs-grid">
                                <div class="spec-item">
                                    <div class="spec-label">Marca</div>
                                    <div class="spec-value">@Model.Marca?.ToUpper()</div>
                                </div>
                                <div class="spec-item">
                                    <div class="spec-label">Categoria</div>
                                    <div class="spec-value">@Model.Categoria?.ToUpper()</div>
                                </div>
                                <div class="spec-item">
                                    <div class="spec-label">Ano</div>
                                    <div class="spec-value">@Model.Ano</div>
                                </div>
                                <div class="spec-item">
                                    <div class="spec-label">Quilometragem</div>
                                    <div class="spec-value">@Model.Quilometragem km</div>
                                </div>
                                <div class="spec-item">
                                    <div class="spec-label">Combustível</div>
                                    <div class="spec-value">@Model.Combustivel?.ToUpper()</div>
                                </div>
                                <div class="spec-item">
                                    <div class="spec-label">Cor</div>
                                    <div class="spec-value">@Model.Cor?.ToUpper()</div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Descricao))
                                {
                                    <div class="spec-item" style="grid-column: 1 / -1;">
                                        <div class="spec-label">Descrição</div>
                                        <div class="spec-value">@Model.Descricao</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="action-buttons">
                            <a href="#" class="btn-premium">
                                <i class="bi bi-whatsapp"></i> Entrar em Contato
                            </a>
                            <a href="#" class="btn-outline-premium">
                                <i class="bi bi-calendar-check"></i> Agendar Test Drive
                            </a>
                        </div>
                    </div>
                </div>

                <!-- COMPARAÇÃO DE PREÇOS -->
                <div class="row mt-5 fade-in-up" style="animation-delay: 0.4s;">
                    <div class="col-12">
                        <div class="comparison-card">
                            <h4 class="comparison-title">Compare os Preços</h4>
                            <div class="price-comparison">
                                <!-- Valor Anunciado -->
                                <div class="price-column">
                                    <div class="price-source">Valor Anunciado</div>
                                    <div class="price-amount">R$ @Model.Preco.ToString("N0")</div>
                                    <div class="price-description">
                                        Preço especial FourPrime<br>Condição exclusiva
                                    </div>
                                </div>

                                <!-- Webmotors -->
                                <div class="price-column">
                                    <div class="price-source">Webmotors</div>
                                    <div class="price-amount">R$ 0,00</div>
                                    <div class="price-description">
                                        Valor médio de carros iguais<br>anunciado na Webmotors
                                    </div>
                                </div>

                                <!-- FIPE -->
                                <div class="price-column">
                                    <div class="price-source">Tabela FIPE</div>
                                    <div class="price-amount">R$ 0,00</div>
                                    <div class="price-description">
                                        Valor de referência<br>na Tabela FIPE
                                    </div>
                                </div>
                            </div>
                            <div class="text-center mt-4">
                                <p class="text-muted small">
                                    Consulte aqui <strong class="text-glow">@Model.Modelo.ToUpper()</strong> na tabela <strong>FIPE Webmotors</strong> do seu estado.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Interatividade dos botões de favorito
        document.addEventListener('DOMContentLoaded', function() {
            const favoriteBtn = document.querySelector('.favorite-btn');

            if (favoriteBtn) {
                favoriteBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const icon = this.querySelector('i');

                    if (icon.classList.contains('bi-heart')) {
                        icon.classList.remove('bi-heart');
                        icon.classList.add('bi-heart-fill');
                        this.style.background = 'linear-gradient(135deg, #990100, #660000)';
                        this.style.color = 'white';
                        this.innerHTML = '<i class="bi bi-heart-fill"></i> Adicionado aos Favoritos';
                    } else {
                        icon.classList.remove('bi-heart-fill');
                        icon.classList.add('bi-heart');
                        this.style.background = 'rgba(26, 26, 26, 0.8)';
                        this.style.color = '#cfcfcf';
                        this.innerHTML = '<i class="bi bi-heart"></i> Adicionar aos Favoritos';
                    }
                });
            }
        });
    </script>
</body>
</html>