@model FourPrime.Domain.Entities.Categoria

@{
    ViewData["Title"] = "Excluir Categoria";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <title>FourPrime | @ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0f0f0f 100%);
            min-height: 100vh;
            font-family: 'Mulish', sans-serif;
            color: #eaeaea;
            padding: 20px;
        }

        .delete-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .header-section {
            margin-bottom: 30px;
        }

        .page-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 2.5rem;
            color: #ffe6e6;
            text-shadow: 0 4px 15px rgba(153, 1, 0, 0.3);
            margin-bottom: 10px;
        }

        .back-btn {
            background: rgba(26, 26, 26, 0.8);
            border: 1px solid rgba(153, 1, 0, 0.4);
            color: #cfcfcf;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

            .back-btn:hover {
                background: linear-gradient(135deg, #990100, #660000);
                color: white;
                border-color: transparent;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(153, 1, 0, 0.3);
            }

        .delete-card {
            background: rgba(21, 21, 21, 0.8);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(153, 1, 0, 0.3);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4), 0 5px 15px rgba(153, 1, 0, 0.2);
            overflow: hidden;
            position: relative;
        }

            .delete-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #990100, #ff3333, #990100);
                z-index: 2;
            }

        .card-header {
            background: linear-gradient(135deg, #990100, #660000);
            padding: 25px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .card-title {
            color: white;
            font-weight: 700;
            font-size: 1.4rem;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-body {
            padding: 30px;
        }

        .warning-icon {
            font-size: 3rem;
            color: #ff6b6b;
            margin-bottom: 20px;
        }

        .warning-title {
            color: #ff6b6b;
            font-weight: 700;
            font-size: 1.5rem;
            margin-bottom: 20px;
        }

        .info-grid {
            background: rgba(26, 26, 26, 0.6);
            border-radius: 15px;
            padding: 25px;
            margin: 25px 0;
            border-left: 4px solid #990100;
        }

        .info-item {
            display: flex;
            justify-content: between;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

            .info-item:last-child {
                margin-bottom: 0;
                padding-bottom: 0;
                border-bottom: none;
            }

        .info-label {
            color: #cfcfcf;
            font-weight: 600;
            min-width: 200px;
        }

        .info-value {
            color: #ffe6e6;
            font-weight: 700;
        }

        .alert-warning-custom {
            background: linear-gradient(135deg, rgba(255, 193, 7, 0.1), rgba(255, 193, 7, 0.05));
            border: 1px solid rgba(255, 193, 7, 0.3);
            border-radius: 15px;
            padding: 20px;
            margin: 25px 0;
            backdrop-filter: blur(10px);
        }

            .alert-warning-custom strong {
                color: #ffc107;
            }

        .btn-danger-custom {
            background: linear-gradient(135deg, #dc3545, #c82333);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 700;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-danger-custom:hover {
                background: linear-gradient(135deg, #c82333, #bd2130);
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(220, 53, 69, 0.4);
                color: white;
            }

        .btn-secondary-custom {
            background: rgba(26, 26, 26, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #cfcfcf;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-secondary-custom:hover {
                background: rgba(255, 255, 255, 0.1);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
            }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        .cars-count {
            background: linear-gradient(135deg, #990100, #660000);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            margin-left: 10px;
        }

 
        .fade-in-up {
            animation: fadeInUp 0.6s ease-out;
        }
    </style>
</head>
<body>
    <div class="delete-container fade-in-up">
        <!-- Header -->
        <div class="header-section">
            <h1 class="page-title">@ViewData["Title"]</h1>
            <a asp-action="Index" class="back-btn">
                <i class="bi bi-arrow-left"></i> Voltar para Lista
            </a>
        </div>

        <!-- Delete Card -->
        <div class="delete-card">
            <div class="card-header">
                <h2 class="card-title">
                    <i class="bi bi-exclamation-triangle"></i>
                    Confirmação de Exclusão
                </h2>
            </div>

            <div class="card-body">
                <!-- Warning Icon -->
                <div class="text-center">
                    <i class="bi bi-exclamation-circle warning-icon"></i>
                    <h3 class="warning-title">Tem certeza que deseja excluir esta categoria?</h3>
                </div>

                <!-- Category Information -->
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Nome da Categoria:</span>
                        <span class="info-value">@Model.Nome</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Descrição:</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.Descricao) ? "Nenhuma descrição" : Model.Descricao)</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Carros Associados:</span>
                        <span class="info-value">
                            @(Model.Carros?.Count ?? 0)
                            <span class="cars-count">@(Model.Carros?.Count ?? 0) CARRO(S)</span>
                        </span>
                    </div>
                </div>

                @if (Model.Carros?.Any() == true)
                {
                    <!-- Warning Alert -->
                    <div class="alert-warning-custom">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-shield-exclamation" style="font-size: 1.5rem; color: #ffc107;"></i>
                            <div>
                                <strong>Atenção!</strong> Esta categoria possui @Model.Carros.Count carro(s) associado(s).<br>
                                <small>Não é possível excluir categorias com carros vinculados.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        <a asp-action="Index" class="btn-secondary-custom">
                            <i class="bi bi-arrow-left"></i> Voltar para Lista
                        </a>
                    </div>
                }
                else
                {
                    <!-- Delete Form -->
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="action-buttons">
                            <button type="submit" class="btn-danger-custom">
                                <i class="bi bi-trash3"></i> Confirmar Exclusão
                            </button>
                            <a asp-action="Index" class="btn-secondary-custom">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>