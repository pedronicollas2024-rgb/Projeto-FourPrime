@model List<FourPrime.Web.Areas.Admin.Models.UserReportRowVm>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/Logo1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <title>FourPrime Garage - Relatórios</title>

    <style>
        body { background:#0f0f0f; color:#eaeaea; font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

        .sidebar{
            position:relative; box-shadow:0 0 25px rgba(153,1,0,.25);
            border-right:1px solid rgba(153,1,0,.25); background:#151515; min-height:100vh;
        }
        .sidebar:before{
            content:""; position:absolute; right:-2px; top:0; width:2px; height:100%;
            background:linear-gradient(180deg,#990100,#660000);
            box-shadow:0 0 15px #990100, 0 0 30px #990100, 0 0 45px #990100;
        }
        .sidebar .nav-link{
            color:#cfcfcf; padding:12px 20px; margin:4px 0; border-radius:8px;
            transition:.2s; text-decoration:none;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active{
            background:rgba(153,1,0,.18); color:#ff3333; font-weight:500;
        }
        .sidebar h4{
            color:#ffe6e6!important; text-shadow:0 0 8px #990100, 0 0 15px #990100;
            font-weight:700; letter-spacing:1px;
        }

        .main-content{ background:#0c0c0c; min-height:100vh; }
        .page-header{
            background:linear-gradient(135deg,#1a1a1a,#151515);
            border-radius:20px; padding:24px; margin-bottom:20px;
            border:1px solid rgba(153,1,0,.3);
            box-shadow:0 10px 30px rgba(0,0,0,.3);
        }
        .page-title{
            color:#ffe6e6; font-weight:800; font-size:2rem; margin:0;
            text-shadow:0 2px 10px rgba(153,1,0,.3);
        }
        .page-subtitle{ color:#cfcfcf; margin:6px 0 0; }

        .panel{
            background:rgba(21,21,21,.8); backdrop-filter:blur(10px);
            border-radius:15px; padding:18px;
            border:1px solid rgba(153,1,0,.3);
            box-shadow:0 8px 25px rgba(0,0,0,.2);
        }

        .search-box{
            background:#1a1a1a; border:1px solid rgba(153,1,0,.3);
            border-radius:12px; color:#eaeaea; padding:12px 16px;
        }
        .search-box:focus{
            outline:none; border-color:#990100;
            box-shadow:0 0 15px rgba(153,1,0,.4);
        }

        .table-dark-custom{
            --bs-table-bg: transparent;
            --bs-table-color: #eaeaea;
            border-color: rgba(153,1,0,.25);
        }
        .table-dark-custom thead th{
            color:#ffe6e6; border-bottom:1px solid rgba(153,1,0,.3);
        }
        .badge-role{
            background:linear-gradient(135deg,#990100,#660000);
            border:1px solid rgba(255,255,255,.2);
        }
    </style>
</head>

<body>
<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 sidebar p-0">
            <div class="p-4">
                <h4 class="text-center mb-4">
                    <i class="bi bi-speedometer2"></i> FourPrime Admin
                </h4>
                <nav class="nav flex-column">
                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-house"></i> Dashboard
                    </a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Carros" asp-action="Index">
                        <i class="bi bi-car-front"></i> Gerenciar Carros
                    </a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Marcas" asp-action="Index">
                        <i class="bi bi-tags"></i> Gerenciar Marcas
                    </a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Categorias" asp-action="Index">
                        <i class="bi bi-grid"></i> Gerenciar Categorias
                    </a>
                    <a class="nav-link" href="#"><i class="bi bi-image"></i> Banner & Imagens</a>
                    <a class="nav-link" href="#"><i class="bi bi-gear"></i> Configurações</a>

                    <a class="nav-link active" asp-area="Admin" asp-controller="Relatorios" asp-action="Index">
                        <i class="bi bi-bar-chart"></i> Relatórios
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 main-content p-0">
            <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary p-3">
                <div class="container-fluid">
                    <span class="navbar-brand mb-0 h1">
                        <i class="bi bi-bar-chart me-2"></i>Relatórios
                    </span>
                    <div class="d-flex align-items-center">
                        <a asp-controller="Home" asp-action="Index" asp-area="" class="btn btn-outline-light me-2">
                            <i class="bi bi-arrow-left"></i> Voltar ao Site
                        </a>
                    </div>
                </div>
            </nav>

            <div class="container-fluid p-4">

                <div class="page-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h1 class="page-title">Usuários</h1>
                            <p class="page-subtitle">Lista de e-mails e roles (senhas não são exibidas)</p>
                        </div>
                        <div class="badge badge-role px-3 py-2 rounded-pill">
                            <i class="bi bi-people me-2"></i>@Model.Count usuário(s)
                        </div>
                    </div>
                </div>

                <div class="panel mb-3">
                    <input id="searchInput" class="form-control search-box" placeholder="Buscar por nome, email, username ou role..." />
                </div>

                <div class="panel">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle table-dark-custom">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Email</th>
                                    <th>UserName</th>
                                    <th>Role</th>
                                </tr>
                            </thead>
                            <tbody id="usersBody">
                                @foreach (var u in Model)
                                {
                                    <tr data-search="@($"{u.NomeCompleto} {u.Email} {u.UserName} {u.Role}".ToLower())">
                                        <td>@(string.IsNullOrWhiteSpace(u.NomeCompleto) ? "-" : u.NomeCompleto)</td>
                                        <td>@u.Email</td>
                                        <td>@u.UserName</td>
                                        <td><span class="badge badge-role">@u.Role</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="text-muted mt-2">
                        * Senhas não podem ser listadas. Se você precisar, crie fluxo de “Resetar senha”.
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
    document.getElementById('searchInput')?.addEventListener('input', function (e) {
        const term = e.target.value.toLowerCase();
        document.querySelectorAll('#usersBody tr').forEach(tr => {
            const data = tr.getAttribute('data-search') || '';
            tr.style.display = data.includes(term) ? '' : 'none';
        });
    });
</script>
</body>
</html>