@model FourPrime.Web.Areas.Admin.Models.CategoriaEditVm

@{
    ViewData["Title"] = "Editar Categoria";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/Logo1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <title>FourPrime Garage - @ViewData["Title"]</title>
    <style>
        /* ======= TEMA PRINCIPAL ======= */
        body {
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0f0f0f 100%);
            color: #eaeaea;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 20% 80%, rgba(153, 1, 0, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(153, 1, 0, 0.08) 0%, transparent 50%), radial-gradient(circle at 40% 40%, rgba(153, 1, 0, 0.05) 0%, transparent 50%);
                pointer-events: none;
                z-index: -1;
            }

        /* ======= GLOW EFFECTS ======= */
        .glow-effect {
            position: relative;
        }

            .glow-effect::after {
                content: '';
                position: absolute;
                top: -2px;
                left: -2px;
                right: -2px;
                bottom: -2px;
                background: linear-gradient(45deg, #990100, #660000, #ff3333, #990100);
                border-radius: inherit;
                z-index: -1;
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .glow-effect:hover::after {
                opacity: 0.3;
            }

        /* ======= CARDS PREMIUM ======= */
        .admin-card {
            border: none;
            border-radius: 20px;
            background: rgba(21, 21, 21, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(153, 1, 0, 0.2);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 2px 8px rgba(153, 1, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }

            .admin-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #990100, #ff3333, #990100);
                background-size: 200% 100%;
                animation: shimmer 3s infinite linear;
            }

            .admin-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(153, 1, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            }

        .card-header-custom {
            background: linear-gradient(135deg, rgba(153, 1, 0, 0.9), rgba(102, 0, 0, 0.9));
            border-radius: 20px 20px 0 0 !important;
            padding: 1.5rem 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

            .card-header-custom::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.1) 50%, transparent 70%);
                animation: shine 3s infinite linear;
            }

        /* ======= BOTÕES PREMIUM ======= */
        .btn-admin {
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
            border: none;
            padding: 12px 28px;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
        }

            .btn-admin::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.6s;
            }

            .btn-admin:hover::before {
                left: 100%;
            }

        .btn-warning {
            background: linear-gradient(135deg, #cc0000, #800000, #cc0000);
            background-size: 200% 100%;
            color: white;
            box-shadow: 0 4px 15px rgba(204, 0, 0, 0.3);
        }

            .btn-warning:hover {
                background-position: 100% 0;
                transform: translateY(-3px) scale(1.05);
                box-shadow: 0 8px 25px rgba(204, 0, 0, 0.4);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #2d2d2d, #1a1a1a);
            color: #eaeaea;
            border: 1px solid #444;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

            .btn-secondary:hover {
                background: linear-gradient(135deg, #3d3d3d, #2a2a2a);
                transform: translateY(-3px);
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
                color: white;
            }

        /* ======= FORMULÁRIOS PREMIUM ======= */
        .form-control, .form-select {
            background: rgba(26, 26, 26, 0.8);
            border: 2px solid rgba(51, 51, 51, 0.6);
            color: #eaeaea;
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
        }

            .form-control:focus, .form-select:focus {
                background: rgba(31, 31, 31, 0.9);
                border-color: #990100;
                box-shadow: 0 0 0 0.25rem rgba(153, 1, 0, 0.25), 0 4px 20px rgba(153, 1, 0, 0.15);
                color: #eaeaea;
                transform: translateY(-2px);
            }

        .form-label {
            color: #cfcfcf;
            font-weight: 600;
            margin-bottom: 10px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-group-text {
            background: linear-gradient(135deg, #990100, #660000);
            border: 2px solid rgba(51, 51, 51, 0.6);
            border-right: none;
            color: white;
            border-radius: 12px 0 0 12px;
        }

        /* ======= HEADER PREMIUM ======= */
        .page-header {
            border-bottom: 1px solid rgba(153, 1, 0, 0.3);
            padding-bottom: 2rem;
            margin-bottom: 3rem;
            position: relative;
        }

            .page-header::after {
                content: '';
                position: absolute;
                bottom: -1px;
                left: 0;
                width: 100px;
                height: 3px;
                background: linear-gradient(90deg, #990100, transparent);
                border-radius: 2px;
            }

        .page-title {
            color: #ffe6e6;
            text-shadow: 0 2px 10px rgba(153, 1, 0, 0.3);
            font-weight: 800;
            font-size: 2.5rem;
            letter-spacing: -0.5px;
            position: relative;
            display: inline-block;
        }

            .page-title::after {
                content: '';
                position: absolute;
                bottom: -10px;
                left: 0;
                width: 60px;
                height: 4px;
                background: linear-gradient(90deg, #990100, #ff3333);
                border-radius: 2px;
            }

        /* ======= BADGE PREMIUM ======= */
        .edit-badge {
            background: linear-gradient(135deg, #cc0000, #800000);
            color: white;
            padding: 0.7rem 1.5rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(204, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

            .edit-badge::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
                transform: rotate(45deg);
                animation: badgeShine 3s infinite;
            }



        .fade-in {
            animation: fadeIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        /* ======= CONTAINER ======= */
        .container-custom {
            max-width: 1000px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }

        /* ======= VALIDAÇÃO PREMIUM ======= */
        .field-validation-error {
            font-size: 0.85rem;
            margin-top: 6px;
            display: block;
            color: #ff6b6b;
            font-weight: 500;
            padding-left: 10px;
            border-left: 3px solid #ff6b6b;
        }

        .validation-summary-errors {
            background: rgba(153, 1, 0, 0.1);
            border: 1px solid rgba(153, 1, 0, 0.3);
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            backdrop-filter: blur(5px);
            border-left: 5px solid #990100;
        }

            .validation-summary-errors ul {
                margin-bottom: 0;
                padding-left: 1rem;
            }

        /* ======= DECORAÇÕES ======= */
        .floating-elements {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .floating-element {
            position: absolute;
            background: rgba(153, 1, 0, 0.03);
            border: 1px solid rgba(153, 1, 0, 0.1);
            border-radius: 50%;
            animation: float 20s infinite linear;
        }

 

        {
            transform: translate(0, 0) rotate(0deg);
        }

        25% {
            transform: translate(100px, 50px) rotate(90deg);
        }

        50% {
            transform: translate(50px, 100px) rotate(180deg);
        }

        75% {
            transform: translate(-50px, 50px) rotate(270deg);
        }

 
    </style>
</head>
<body>
    <!-- Elementos flutuantes de fundo -->
    <div class="floating-elements">
        <div class="floating-element" style="width: 100px; height: 100px; top: 10%; left: 5%; animation-delay: 0s;"></div>
        <div class="floating-element" style="width: 150px; height: 150px; top: 60%; left: 80%; animation-delay: -5s;"></div>
        <div class="floating-element" style="width: 80px; height: 80px; top: 80%; left: 20%; animation-delay: -10s;"></div>
        <div class="floating-element" style="width: 120px; height: 120px; top: 30%; left: 70%; animation-delay: -15s;"></div>
    </div>

    <div class="container-custom fade-in">
        <!-- Cabeçalho da página -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center flex-wrap gap-3">
                    <h1 class="page-title mb-0">
                        <i class="bi bi-pencil-square me-3"></i>@ViewData["Title"]
                    </h1>
                    <span class="edit-badge">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Modo Edição Ativo
                    </span>
                </div>
                <a asp-action="Index" class="btn btn-secondary btn-admin glow-effect">
                    <i class="bi bi-arrow-left me-2"></i>Voltar à Lista
                </a>
            </div>
        </div>

        <!-- Card do formulário -->
        <div class="admin-card glow-effect">
            <div class="card-header-custom">
                <div class="d-flex align-items-center">
                    <i class="bi bi-tags-fill me-3 fs-4 text-white"></i>
                    <h5 class="m-0 text-white fw-bold">
                        EDITAR DADOS DA CATEGORIA
                    </h5>
                </div>
            </div>
            <div class="card-body p-5">
                <form asp-action="Edit" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <input type="hidden" asp-for="Id" />

                    <!-- Partial do formulário -->
                    <partial name="_Form" model="Model" />

                    <!-- Botões de ação -->
                    <div class="form-group mt-5 pt-4 border-top border-secondary">
                        <div class="d-flex gap-3 flex-wrap">
                            <button type="submit" class="btn btn-warning btn-admin glow-effect">
                                <i class="bi bi-check-circle-fill me-2"></i>Salvar Alterações
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-admin glow-effect">Cancelar</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>