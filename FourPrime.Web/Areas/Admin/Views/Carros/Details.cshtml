@model FourPrime.Domain.Entities.Carro

@{
    ViewData["Title"] = "Detalhes do Carro";
    Layout = null;
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body { background:#0a0a0a; color:#eaeaea; padding:20px; font-family:Segoe UI, Roboto, Arial; }
        .header { display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; }
        .card-neon { background:#0f0f0f; border:1px solid rgba(0,255,135,0.08); box-shadow:0 0 14px rgba(0,255,135,0.06); border-radius:12px; }
        .neon-btn { background:linear-gradient(135deg,#00ff87,#00d46a); color:#000; border:none; padding:8px 14px; border-radius:8px; font-weight:600; }
    </style>
</head>
<body>

    <div class="header">
        <div>
            <h2 class="mb-0">Detalhes do Carro</h2>
            <small class="text-muted">@Model.Modelo</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/" class="neon-btn"><i class="bi bi-arrow-left-circle me-1"></i> Voltar ao site</a>
            <a asp-action="Index" class="btn btn-outline-light">Voltar ao gerenciador</a>
        </div>
    </div>

    <div class="card card-neon mb-4">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-4">
                    @if (!string.IsNullOrEmpty(Model.ImagemUrl))
                    {
                        <img src="@Model.ImagemUrl" class="img-fluid rounded" alt="@Model.Modelo" />
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-car-front display-1"></i>
                            <p>Nenhuma imagem disponível</p>
                        </div>
                    }
                </div>

                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-4">Modelo:</dt>
                        <dd class="col-sm-8">@Model.Modelo</dd>

                        <dt class="col-sm-4">Marca:</dt>
                        <dd class="col-sm-8">@Model.Marca?.Nome</dd>

                        <dt class="col-sm-4">Categoria:</dt>
                        <dd class="col-sm-8">@Model.Categoria?.Nome</dd>

                        <dt class="col-sm-4">Ano:</dt>
                        <dd class="col-sm-8">@Model.Ano</dd>

                        <dt class="col-sm-4">Preço:</dt>
                        <dd class="col-sm-8">R$ @Model.Preco.ToString("N2")</dd>

                        <dt class="col-sm-4">Cor:</dt>
                        <dd class="col-sm-8">@Model.Cor</dd>

                        <dt class="col-sm-4">Quilometragem:</dt>
                        <dd class="col-sm-8">@Model.Quilometragem.ToString("N0") km</dd>

                        @if (!string.IsNullOrEmpty(Model.Descricao))
                        {
                            <dt class="col-sm-4">Descrição:</dt>
                            <dd class="col-sm-8">@Model.Descricao</dd>
                        }
                    </dl>

                    <div class="mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
                        <a asp-action="Index" class="btn btn-secondary">Voltar para a Lista</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
<style>
  /* ======= BASE ======= */
body { 
    background:#0a0a0a; 
    color:#eaeaea; 
    padding:20px; 
    font-family:Segoe UI, Roboto, Arial; 
}

.header { 
    display:flex; 
    justify-content:space-between; 
    align-items:center; 
    margin-bottom:18px; 
}

/* ======= CARD NEON (VERMELHO) ======= */
.card-neon, .card, .card-body {
    background:#0f0f0f !important;
    border:1px solid rgba(255,0,50,0.20);
    border-radius:12px;
    box-shadow:0 0 15px rgba(255,0,50,0.18);
    color:#eaeaea !important;
}

/* ======= TÍTULOS ======= */
h1, h2, h3, h4, h5, h6 {
    color:#ffffff !important;
    text-shadow:0 0 10px #ff0033;
}

/* ======= TEXTOS INTERNOS ======= */
.card p, .card span, .card small {
    color:#eaeaea !important;
}

dt, dd, label, .form-label, .control-label {
    color:#eaeaea !important;
    font-weight:500;
}

/* ======= BOTÃO NEON VERMELHO ======= */
.neon-btn {
    background:linear-gradient(135deg,#ff0033,#cc0022);
    color:#fff;
    border:none;
    padding:8px 14px;
    border-radius:8px;
    font-weight:600;
    text-shadow:0 0 5px #ff0033;
    box-shadow:0 0 15px rgba(255,0,50,0.45);
}

.neon-btn:hover {
    filter:brightness(1.15);
    box-shadow:0 0 25px #ff0033;
    color:#fff;
}

/* ======= BOTÃO WARNING ======= */
.btn-warning {
    background:linear-gradient(135deg,#ffcc66,#ff9900);
    border:none;
    color:#000 !important;
    font-weight:600;
}

/* ======= BOTÃO SECUNDÁRIO ======= */
.btn-secondary {
    background:#202020;
    border:1px solid #555;
    color:#eaeaea !important;
}

/* ======= BOTÃO OUTLINE NEON ======= */
.btn-outline-neon {
    border:2px solid #ff0033;
    color:#ff0033 !important;
    font-weight:600;
    border-radius:8px;
}

.btn-outline-neon:hover {
    background:#ff0033;
    color:#000 !important;
    box-shadow:0 0 18px #ff0033;
}

/* ======= BORDA DA IMAGEM ======= */
img {
    border-radius:8px;
    box-shadow:0 0 12px rgba(255,0,50,0.25);
}


</style>

</html>
