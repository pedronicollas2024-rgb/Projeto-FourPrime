<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Categorias\" />
    <Folder Include="Handlers\" />
    <Folder Include="Marcas\" />
    <Folder Include="Nav\" />
    <Folder Include="Interfaces\" />
    <Folder Include="Img\" />
    <Folder Include="frmLogin\" />
    <Folder Include="ViewModels\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Guna.UI2.WinForms" Version="2.0.4.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FourPrime.Api\FourPrime.Api.csproj" />
    <ProjectReference Include="..\FourPrime.Application\FourPrime.Application.csproj" />
    <ProjectReference Include="..\FourPrime.Domain\FourPrime.Domain.csproj" />
    <ProjectReference Include="..\FourPrime.Infrastructure\FourPrime.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FrmCategoriaForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FrmCarroForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="UserControls\ucGerenciarCarros.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UserControls\ucGerenciarCategorias.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>