@model IEnumerable<FourPrime.Domain.Entities.Marca>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/Logo1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <title>FourPrime Garage - Gerenciar Marcas</title>

    <style>
        /* ======= TEMA PRINCIPAL ======= */
        body {
            background: #0f0f0f;
        }

        /* ======= SIDEBAR ======= */
        .sidebar {
            position: relative;
            box-shadow: 0 0 25px rgba(153, 1, 0, 0.25);
            border-right: 1px solid rgba(153, 1, 0, 0.25);
        }

            .sidebar:before {
                content: "";
                position: absolute;
                right: -2px;
                top: 0;
                width: 2px;
                height: 100%;
                background: linear-gradient(180deg, #990100, #7a0000);
                box-shadow: 0 0 15px #990100, 0 0 30px #990100, 0 0 45px #990100;
            }

            .sidebar .nav-link {
                color: #cfcfcf;
                padding: 12px 20px;
                margin: 4px 0;
                border-radius: 8px;
                transition: 0.2s;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background: rgba(153, 1, 0, 0.18);
                    color: #ff2a2a;
                    font-weight: 500;
                }

                .sidebar .nav-link i {
                    margin-right: 10px;
                }

            .sidebar h4 {
                color: #ffe5e5 !important;
                text-shadow: 0 0 8px #990100, 0 0 15px #990100;
                font-weight: 700;
                letter-spacing: 1px;
            }

        /* ======= MAIN CONTENT ======= */
        .main-content {
            background-color: #0c0c0c;
            color: #eaeaea;
        }

        /* ======= CARDS ======= */
        .stat-card {
            border: none;
            border-radius: 15px;
            background: #151515;
            box-shadow: 0 0 20px rgba(153, 1, 0, 0.05);
            transition: transform 0.3s ease;
            color: #eaeaea;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 0 25px rgba(153, 1, 0, 0.15);
            }

            .stat-card.primary {
                background: linear-gradient(135deg, #990100, #7a0000);
                color: #fff;
            }

            .stat-card.success {
                background: linear-gradient(135deg, #b30000, #800000);
                color: #fff;
            }

            .stat-card.warning {
                background: linear-gradient(135deg, #cc1a1a, #7a0000);
                color: #fff;
            }

            .stat-card.info {
                background: linear-gradient(135deg, #e60000, #990100);
                color: #fff;
            }

        /* ======= TABELAS ======= */
        .table-container {
            background: #151515;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(153,1,0,0.06);
            color: white;
        }

        .table thead {
            background: #1a1a1a;
            color: #ff1a1a;
        }

        .table tbody tr:hover {
            background: rgba(153,1,0,0.05);
        }

        /* ======= BADGES ======= */
        .badge-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
        }

        .bg-success {
            background-color: #990100 !important;
            color: white !important;
        }

        .bg-warning {
            background-color: #cc4d4d !important;
            color: white !important;
        }

        .bg-secondary {
            background-color: #5c5c5c !important;
        }

        /* ======= BOTÕES ======= */
        .btn-primary {
            background: linear-gradient(135deg, #990100, #7a0000);
            border: none;
        }

            .btn-primary:hover {
                filter: brightness(1.1);
            }

        .btn-outline-primary {
            border: 1px solid #990100;
            color: #ff2a2a;
        }

            .btn-outline-primary:hover {
                background: #990100;
                color: #000;
            }

        /* Avatar */
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #990100;
        }

        /* ======= BOTÕES NEON ======= */
        .btn-neon {
            position: relative;
            overflow: hidden;
            color: #ff2a2a;
            border: 2px solid #990100;
            border-radius: 10px;
            padding: 10px 25px;
            background: transparent;
            font-weight: 600;
            text-shadow: 0 0 5px #990100;
            transition: 0.25s;
        }

            .btn-neon:hover {
                background: #990100;
                color: #000;
                box-shadow: 0 0 10px #990100, 0 0 20px #990100, 0 0 40px #990100;
            }

        /* ======= NEON ANIMADO ======= */
        .btn-neon-animado {
            border: none;
            position: relative;
            padding: 12px 30px;
            border-radius: 10px;
            background: #0f0f0f;
            color: #ff2a2a;
            font-weight: 600;
            overflow: hidden;
        }

            .btn-neon-animado::before {
                content: "";
                position: absolute;
                inset: 0;
                padding: 2px;
                border-radius: inherit;
                background: linear-gradient(120deg, #990100, #4d0000, #990100);
                -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                animation: glowBorder 2s linear infinite;
            }

        /* ======= CARDS DE ACESSO NEON ======= */
        .access-card {
            background: #111;
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            cursor: pointer;
            border: 2px solid rgba(153,1,0,0.25);
            transition: 0.3s;
            box-shadow: 0 0 10px rgba(153,1,0,0.15);
        }

            .access-card:hover {
                border-color: #990100;
                box-shadow: 0 0 25px rgba(153,1,0,0.35);
                transform: translateY(-5px);
            }

            .access-card i {
                font-size: 2.5rem;
                color: #ff1a1a;
                margin-bottom: 10px;
            }

            .access-card h5 {
                color: #ff1a1a;
                font-weight: 600;
            }

        /* imagens */
        .car-img {
            width: 55px;
            height: 55px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid #990100;
        }

        /* ======= BARRA DE PESQUISA ======= */
        .search-container {
            background: #151515;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 0 15px rgba(153,1,0,0.06);
            border: 1px solid rgba(153,1,0,0.1);
        }

        .search-box {
            background: #1a1a1a;
            border: 1px solid rgba(153,1,0,0.3);
            border-radius: 10px;
            color: #eaeaea;
            padding: 10px 15px;
        }

            .search-box:focus {
                background: #1a1a1a;
                border-color: #990100;
                box-shadow: 0 0 10px rgba(153,1,0,0.3);
                color: #eaeaea;
            }

        .filter-select {
            background: #1a1a1a;
            border: 1px solid rgba(153,1,0,0.3);
            border-radius: 10px;
            color: #eaeaea;
            padding: 10px;
        }

            .filter-select:focus {
                background: #1a1a1a;
                border-color: #990100;
                box-shadow: 0 0 10px rgba(153,1,0,0.3);
                color: #eaeaea;
            }

        /* ======= BOTÃO NEON VERMELHO ======= */
        .btn-neon-green {
            background: linear-gradient(135deg, #990100, #7a0000);
            color: #fff !important;
            border: none;
            font-weight: 600;
            box-shadow: 0 0 15px #990100;
            border-radius: 10px;
            padding: 10px 20px;
        }

            .btn-neon-green:hover {
                filter: brightness(1.2);
                box-shadow: 0 0 20px #990100;
                color: #fff !important;
            }

        .btn-outline-neon {
            border: 2px solid #990100;
            color: #ff2a2a !important;
            font-weight: 600;
            border-radius: 10px;
            padding: 10px 20px;
        }

            .btn-outline-neon:hover {
                background: #990100;
                color: #000 !important;
                box-shadow: 0 0 15px #990100;
            }

    </style>
</head>

<body>

    <div class="container-fluid">
        <div class="row">

            <div class="col-md-3 col-lg-2 sidebar p-0">
                <div class="p-4">
                    <h4 class="text-center mb-4">
                        <i class="bi bi-speedometer2"></i>
                        FourPrime Admin
                    </h4>

                    <nav class="nav flex-column">
                        <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-house"></i>
                            Dashboard
                        </a>
                        <a class="nav-link" asp-area="Admin" asp-controller="Carros" asp-action="Index">
                            <i class="bi bi-car-front"></i>
                            Gerenciar Carros
                        </a>
                        <a class="nav-link active" asp-area="Admin" asp-controller="Marcas" asp-action="Index">
                            <i class="bi bi-tags"></i>
                            Gerenciar Marcas
                        </a>
                        <a class="nav-link" asp-area="Admin" asp-controller="Categorias" asp-action="Index">

                            <i class="bi bi-people"></i>

                            Gerenciar Categorias

                        </a>
                        <a class="nav-link" href="#">
                            <i class="bi bi-image"></i>
                            Banner & Imagens
                        </a>
                        <a class="nav-link" href="#">
                            <i class="bi bi-gear"></i>
                            Configurações
                        </a>
                      <a class="nav-link" asp-area="Admin" asp-controller="Relatorios" asp-action="Index">
    <i class="bi bi-bar-chart"></i>
    Relatórios
</a>
                    </nav>
                </div>
            </div>

            <div class="col-md-9 col-lg-10 main-content p-0">
                <nav class="navbar navbar-light bg-black border-bottom p-3 ">
                    <div class="container-fluid ">
                        <span class="navbar-brand mb-0 h1 text-light">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Painel de Administração
                        </span>

                        <div class="d-flex align-items-center">
                            <a asp-controller="Home" asp-action="Index" asp-area="" class="btn btn-outline-secondary me-2">
                                <i class="bi bi-arrow-left"></i> Voltar ao Site
                            </a>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-2"></i>
                                    Admin User
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Meu Perfil</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Configurações</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="index.html"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>

                <div class="container-fluid p-4">
                    
                    <!-- ALERTAS -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Erro!</strong> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    <!-- BARRA DE PESQUISA E AÇÕES -->
                    <div class="filters-section">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <div class="filter-label">
                                    <i class="bi bi-search me-2"></i>Pesquisar Marcas
                                </div>
                                <input type="text" class="form-control search-box" id="searchInput" placeholder="Digite nome, país...">
                            </div>
                            <div class="col-md-6 text-end">
                                <a asp-action="Create" class="btn-neon-green me-2">
                                    <i class="bi bi-plus-circle me-2"></i> Nova Marca
                                </a>
                                <button class="btn btn-outline-neon me-2" onclick="resetFilters()">
                                    <i class="bi bi-arrow-clockwise me-2"></i> Limpar
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- LISTA DE MARCAS -->
                    <div class="table-container">
                        <div class="card border-0">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Lista de Marcas</h5>
                                <span class="badge bg-primary">@Model.Count() marcas</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Logo</th>
                                                <th>Nome</th>
                                                <th>País de Origem</th>
                                                <th>Ano Fundação</th>
                                                <th>Carros Vinculados</th>
                                                <th>Status</th>
                                                <th>Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody id="marcaTableBody">
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="marca-icon">
                                                            <i class="bi bi-tag"></i>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <strong>@item.Nome</strong>
                                                    </td>
                                                    <td>
                                                        <span class="badge-pais">@item.PaisOrigem</span>
                                                    </td>
                                                    <td>@item.AnoFundacao</td>
                                                    <td>
                                                        <span class="badge-carros">@item.Carros.Count carro(s)</span>
                                                    </td>
                                                    <td>
                                                        @if (item.Carros.Count > 0)
                                                        {
                                                            <span class="badge-status bg-success text-white">Ativa</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge-status bg-secondary text-white">Sem carros</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="btn-group">
                                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                                               class="btn btn-sm btn-outline-warning me-1">
                                                                <i class="bi bi-pencil"></i>
                                                            </a>
                                                            @if (Context.Session.GetString("UsuarioRole") == "Admin")
                                                            {
                                                                <a asp-action="Delete" asp-route-id="@item.Id"
                                                                   class="btn btn-sm btn-outline-danger">
                                                                    <i class="bi bi-trash"></i>
                                                                </a>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm"
            crossorigin="anonymous"></script>

    <script>
        // Busca em tempo real
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#marcaTableBody tr');
            let visibleCount = 0;
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Atualiza o contador
            document.querySelector('.badge.bg-primary').textContent = visibleCount + ' marcas';
        });

        // Função para limpar filtros
        function resetFilters() {
            document.getElementById('searchInput').value = '';
            const rows = document.querySelectorAll('#marcaTableBody tr');
            rows.forEach(row => {
                row.style.display = '';
            });
            document.querySelector('.badge.bg-primary').textContent = '@Model.Count() marcas';
        }
    </script>

</body>
</html>