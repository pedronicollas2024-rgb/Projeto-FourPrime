@model FourPrime.Web.Models.CatalogViewModel
@{
    ViewData["Title"] = "Resultados da Busca | FourPrime";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="/img/Logo1.png">
    <title>@ViewData["Title"]</title>
    <style>
        /* ESTILOS MODERNOS E ELEGANTES */
        body {
            background: linear-gradient(135deg, #0c0c0c 0%, #1a1a1a 100%);
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background: rgba(0, 0, 0, 0.95) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(153, 1, 0, 0.3);
        }

        .vehicle-card {
            background: linear-gradient(145deg, #1a1a1a, #151515);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            overflow: hidden;
            position: relative;
        }

            .vehicle-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: linear-gradient(90deg, transparent, #990100, transparent);
            }

            .vehicle-card:hover {
                transform: translateY(-8px);
                border-color: #990100;
                box-shadow: 0 20px 40px rgba(153, 1, 0, 0.3);
            }

        .vehicle-image {
            height: 220px;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .vehicle-card:hover .vehicle-image {
            transform: scale(1.05);
        }

        .price-tag {
            background: linear-gradient(135deg, #990100, #ff3333);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 1.2rem;
        }

        .stat-badge {
            background: rgba(153, 1, 0, 0.2);
            border: 1px solid rgba(153, 1, 0, 0.5);
            color: #ff6b6b;
            border-radius: 12px;
            padding: 6px 12px;
            font-size: 0.85rem;
        }

        .filter-pill {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            border-radius: 20px;
            padding: 8px 16px;
            backdrop-filter: blur(10px);
        }

        .section-title {
            background: linear-gradient(135deg, #ffffff, #cccccc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 700;
        }

        .btn-premium {
            background: linear-gradient(135deg, #990100, #660000);
            border: none;
            border-radius: 10px;
            padding: 10px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .btn-premium::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
                transition: left 0.5s;
            }

            .btn-premium:hover::before {
                left: 100%;
            }

            .btn-premium:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(153, 1, 0, 0.4);
            }

        .empty-state {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 60px 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
        }

        .feature-icon {
            width: 24px;
            height: 24px;
            background: rgba(153, 1, 0, 0.2);
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 8px;
        }

        .gradient-text {
            background: linear-gradient(135deg, #990100, #ff3333);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>

<body>
    <!-- NAVBAR ELEGANTE -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo cortada.PNG" style="height: auto; width: 160px" alt="FourPrime">
            </a>
            <a asp-action="Index" class="btn btn-outline-light btn-premium">
                <i class="bi bi-arrow-left me-2"></i>Voltar ao Início
            </a>
        </div>
    </nav>

    <!-- RESULTADOS - DESIGN MODERNO -->
    <section class="py-5 min-vh-100">
        <div class="container">
            <!-- HEADER PRINCIPAL -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="section-title display-5 fw-bold mb-2">
                                <i class="bi bi-search me-3"></i>Resultados da Busca
                            </h1>
                            <p class="text-light opacity-75 mb-0">Encontre o veículo dos seus sonhos</p>
                        </div>
                        <div class="stat-badge">
                            <i class="bi bi-car-front-fill me-2"></i>
                            <span class="fw-bold">@Model.Carros.Count</span> veículos
                        </div>
                    </div>

                    <!-- FILTROS APLICADOS -->
                    @if (Model.Filter.HasFilters)
                    {
                        <div class="d-flex flex-wrap gap-3 align-items-center p-4 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                            <span class="text-light opacity-75"><i class="bi bi-funnel me-2"></i>Filtros ativos:</span>

                            @if (!string.IsNullOrEmpty(Model.Filter.TermoPesquisa))
                            {
                                <span class="filter-pill">
                                    <i class="bi bi-search me-2"></i>"@Model.Filter.TermoPesquisa"
                                </span>
                            }
                            @if (Model.Filter.MarcaId.HasValue)
                            {
                                var marcaSelecionada = Model.Marcas.FirstOrDefault(m => m.Id == Model.Filter.MarcaId);
                                <span class="filter-pill">
                                    <i class="bi bi-tag me-2"></i>@marcaSelecionada?.Nome
                                </span>
                            }
                            @if (Model.Filter.CategoriaId.HasValue)
                            {
                                var categoriaSelecionada = Model.Categorias.FirstOrDefault(c => c.Id == Model.Filter.CategoriaId);
                                <span class="filter-pill">
                                    <i class="bi bi-grid me-2"></i>@categoriaSelecionada?.Nome
                                </span>
                            }

                            <a asp-action="Resultados" class="btn btn-outline-light btn-sm ms-2">
                                <i class="bi bi-x-circle me-1"></i>Limpar
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- GRADE DE VEÍCULOS -->
            @if (Model.Carros.Any())
            {
                <div class="row g-4">
                    @foreach (var carro in Model.Carros)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="vehicle-card h-100">
                                <!-- IMAGEM -->
                                @if (!string.IsNullOrEmpty(carro.ImagemUrl))
                                {
                                    <img src="@carro.ImagemUrl" class="vehicle-image w-100" alt="@carro.Modelo">
                                }
                                else
                                {
                                    <div class="vehicle-image w-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #2a2a2a, #1a1a1a);">
                                        <i class="bi bi-car-front display-4 text-light opacity-25"></i>
                                    </div>
                                }

                                <!-- CONTEÚDO -->
                                <div class="card-body d-flex flex-column p-4">
                                    <!-- HEADER -->
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <h5 class="text-white fw-bold mb-1">@carro.Modelo.ToUpper()</h5>
                                            <p class="text-light opacity-75 mb-0">
                                                <i class="bi bi-tag me-1"></i>@carro.Marca
                                            </p>
                                        </div>
                                        <span class="badge bg-dark text-light border border-secondary">@carro.Ano</span>
                                    </div>

                                    <!-- ESPECIFICAÇÕES -->
                                    <div class="d-flex justify-content-between text-sm mb-4">
                                        <span class="text-light opacity-75">
                                            <span class="feature-icon">
                                                <i class="bi bi-speedometer2 text-warning"></i>
                                            </span>
                                            @carro.Quilometragem.ToString("N0") km
                                        </span>
                                        <span class="text-light opacity-75">
                                            <span class="feature-icon">
                                                <i class="bi bi-palette text-info"></i>
                                            </span>
                                            @carro.Cor
                                        </span>
                                    </div>

                                    <!-- PREÇO E BOTÃO -->
                                    <div class="mt-auto pt-3 border-top border-secondary">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="price-tag d-inline-block">R$ @carro.Preco.ToString("N0")</div>
                                                <small class="text-light opacity-75 d-block mt-1">
                                                    <i class="bi bi-fuel-pump me-1"></i>@carro.Combustivel
                                                </small>
                                            </div>
                                            <a asp-controller="Home"
                                               asp-action="Detalhes"
                                               asp-route-id="@carro.Id"
                                               class="btn btn-premium">
                                                <i class="bi bi-eye me-1"></i> Ver
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- ESTADO VAZIO ELEGANTE -->
                <div class="empty-state text-center">
                    <i class="bi bi-search display-1 gradient-text mb-4"></i>
                    <h3 class="text-white mb-3">Nenhum veículo encontrado</h3>
                    <p class="text-light opacity-75 mb-4">Tente ajustar os critérios de busca para encontrar mais opções</p>
                    <a asp-action="Index" class="btn btn-premium px-4">
                        <i class="bi bi-arrow-left me-2"></i>Voltar ao Catálogo
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- FOOTER ELEGANTE -->
    <footer class="bg-black py-5 text-center border-top border-secondary">
        <div class="container">
            <a href="#" class="d-inline-block mb-4">
                <img src="/img/logo cortada.PNG" style="height: auto; width: 140px" alt="FourPrime Logo" />
            </a>
            <p class="text-light opacity-75 mb-0">
                <i class="bi bi-c-circle me-1"></i>Desenvolvido por Pixel Flux 2025. Todos os direitos reservados.
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js"></script>
</body>
</html>