@model FourPrime.Domain.Entities.Marca
@{
    ViewData["Title"] = "Excluir Marca";
    Layout = null;
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            background: #0a0a0a;
            color: #ffffff;
            font-family: Segoe UI, Roboto, Arial;
            padding: 25px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .neon-btn {
            background: linear-gradient(135deg,#990100,#660000);
            color: #ffffff;
            border: 1px solid #ffffff;
            padding: 10px 16px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .neon-btn:hover {
                background: linear-gradient(135deg,#b30000,#800000);
                box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
                transform: translateY(-2px);
            }

        .card-neon {
            background: #0f0f0f;
            border: 1px solid #333;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
            border-radius: 14px;
        }

        .alert-warning {
            background: rgba(153, 1, 0, 0.1);
            border: 1px solid #990100;
            color: #ff6b6b;
        }

        .marca-icon {
            width: 60px;
            height: 60px;
            background: rgba(153, 1, 0, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #990100;
            margin-right: 15px;
        }

            .marca-icon i {
                color: #990100;
                font-size: 1.5rem;
            }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <h2 class="mb-0 text-danger">Confirmar Exclusão</h2>
            <small class="text-white-50">ID: @Model.Id — @Model.Nome</small>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="neon-btn"><i class="bi bi-arrow-left-circle me-1"></i> Voltar ao site</a>
            <a asp-action="Index" class="btn btn-outline-light border-secondary text-white">Gerenciador</a>
        </div>
    </div>

    <div class="card card-neon p-4">
        <div class="d-flex align-items-center mb-4">
            <div class="marca-icon">
                <i class="fa-solid fa-tag"></i>
            </div>
            <div>
                <h4 class="text-danger mb-0">Tem certeza que deseja excluir esta marca?</h4>
                <p class="text-white-50 mb-0">Esta ação não pode ser desfeita.</p>
            </div>
        </div>

        <dl class="row">
            <dt class="col-sm-3 text-white">Nome:</dt>
            <dd class="col-sm-9 text-white">@Model.Nome</dd>

            <dt class="col-sm-3 text-white">País de Origem:</dt>
            <dd class="col-sm-9 text-white">@Model.PaisOrigem</dd>

            <dt class="col-sm-3 text-white">Ano de Fundação:</dt>
            <dd class="col-sm-9 text-white">@Model.AnoFundacao</dd>

            <dt class="col-sm-3 text-white">Carros Vinculados:</dt>
            <dd class="col-sm-9 text-white">@Model.Carros.Count</dd>
        </dl>

        @if (Model.Carros.Any())
        {
            <div class="alert alert-warning">
                <strong>Atenção!</strong> Esta marca possui @Model.Carros.Count carro(s) associado(s).
                Não é possível excluir marcas com carros vinculados.
            </div>
            <a asp-action="Index" class="btn btn-secondary border-secondary text-white">Voltar</a>
        }
        else
        {
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger border-white">
                        <i class="fa-solid fa-trash me-1"></i> Confirmar Exclusão
                    </button>
                    <a asp-action="Index" class="btn btn-secondary border-secondary text-white">Cancelar</a>
                </div>
            </form>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
<style>
    /* Texto dos detalhes */
    dt, dd, label, .form-label, .control-label {
        color: #ffffff !important;
        font-weight: 500;
    }

    /* Títulos */
    h1, h2, h3, h4, h5, h6 {
        color: #ffffff !important;
    }

    /* Container principal */
    .card, .card-body {
        background: #0f0f0f !important;
        border: 1px solid #660000;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.05);
        color: #ffffff !important;
    }

        /* Texto de dentro do card */
        .card p, .card span, .card small {
            color: #ffffff !important;
        }

    /* Botões */
    .btn-danger {
        background: linear-gradient(135deg, #990100, #660000);
        border: 1px solid #ffffff;
        color: #fff !important;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #b30000, #800000);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

    .btn-secondary {
        background: #202020;
        border: 1px solid #666;
        color: #ffffff !important;
    }

    /* Botão neon vermelho */
    .btn-neon-red {
        background: linear-gradient(135deg, #990100, #660000);
        color: #fff !important;
        border: 1px solid #ffffff;
        font-weight: 600;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
    }

        .btn-neon-red:hover {
            background: linear-gradient(135deg, #b30000, #800000);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

    /* Botão neon outline */
    .btn-outline-neon {
        border: 2px solid #ffffff;
        color: #ffffff !important;
        font-weight: 600;
        background: transparent;
        transition: all 0.3s ease;
    }

        .btn-outline-neon:hover {
            background: #ffffff;
            color: #000 !important;
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
        }

    /* Efeitos de foco para inputs */
    .form-control:focus {
        border-color: #ffffff !important;
        box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25) !important;
    }

    /* Badges e elementos de status */
    .badge-danger {
        background: linear-gradient(135deg, #990100, #660000) !important;
        color: #fff !important;
        border: 1px solid #ffffff;
    }

    /* Links */
    a {
        color: #ffffff;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        a:hover {
            color: #cccccc;
        }

    /* Textos secundários */
    .text-muted {
        color: #cccccc !important;
    }

    .text-white-50 {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    /* Validação */
    .text-danger {
        color: #ff6b6b !important;
    }

    .field-validation-error {
        color: #ff6b6b !important;
    }

    /* Input hidden - manter sem borda */
    input[type="hidden"] {
        border: none !important;
        background: transparent !important;
    }

    /* Alertas */
    .alert-warning {
        background: rgba(153, 1, 0, 0.1) !important;
        border: 1px solid #990100 !important;
        color: #ff6b6b !important;
    }

</style>
</html>